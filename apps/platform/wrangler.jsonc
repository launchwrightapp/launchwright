{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "launchwright-platform",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Builds the Astro app into dist/ before dev, deploy, and preview uploads.
  "build": { "command": "npm run build" },
  // Production is served only on the custom domains below.
  // Preview URLs (per PR) live on workers.dev.
  "workers_dev": false,
  "preview_urls": true,
  // The worker runs first so every page checks sign-in (worker/index.ts).
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  // ADMIN_GITHUB_IDS: numeric GitHub ids that can open the team inbox (/inbox).
  "vars": { "GITHUB_CLIENT_ID": "Iv23lixXjMCTRCvuULLf", "ADMIN_GITHUB_IDS": "13403945" },
  "routes": [{ "pattern": "platform.launchwright.app", "custom_domain": true }],
  "observability": { "enabled": true },
  // Team replies and message notifications go out from hello@. Email Routing also sends
  // incoming hello@ mail to this worker (the email() handler in worker/index.ts).
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hello@launchwright.app"] }]
  // Secrets (not in this file): GITHUB_CLIENT_SECRET, SESSION_SECRET, DATABASE_URL, and
  // FORWARD_TO (the inbox that gets a copy of every message) via
  // `npx wrangler versions secret put <NAME>`. Locally: .dev.vars (see .dev.vars.example).
}
