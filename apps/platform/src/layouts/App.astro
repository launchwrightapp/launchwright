---
// IDE-style shell: title bar, activity bar, explorer, editor tabs + page,
// bottom panel (tool calls, problems), lesson inspector, status bar.
// Desktop (lg+) fills the viewport and only the panes scroll. Below lg it's a
// normal scrolling page with a menu.
import Base from "../../../../packages/ui/Base.astro";
import ThemeToggle from "../../../../packages/ui/ThemeToggle.astro";
import Mark from "../../../../packages/ui/Mark.astro";
import Dropdown from "../../../../packages/ui/Dropdown.astro";
import Check from "../../../../packages/ui/Check.astro";
import Explain from "../components/Explain.astro";
import ChatBox from "../components/ChatBox.astro";

type PageId = "overview" | "lessons" | "readiness" | "security" | "connect" | "messages" | "inbox" | "applicants" | "funnel";
interface Props { title: string; page: PageId }
const { title, page } = Astro.props;

const icons: Record<PageId, string> = {
  overview: "M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z",
  lessons: "M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM4 21V5M8 7h7",
  readiness: "M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9",
  security: "M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z",
  connect: "M9 7V3M15 7V3M7 7h10v4a5 5 0 0 1-10 0zM12 16v5",
  messages: "M4 5h16v11H9l-5 4z",
  inbox: "M3 13h5l1.5 3h5l1.5-3h5M5.5 5h13L21 13v6H3v-6z",
  funnel: "M3 4h18l-7 8v6l-4 2v-8z",
  applicants: "M16 20v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7M22 20v-1a4 4 0 0 0-3-3.9M16 4.1a3.5 3.5 0 0 1 0 6.8",
};
// The worker removes [data-admin-only] for learners and [data-learner-only] for the team,
// so the team sees operations first, then the learner pages as a preview.
type NavItem = { id: PageId; href: string; label: string; badge?: string; admin?: boolean; learner?: boolean };
const ops: NavItem[] = [
  { id: "applicants", href: "/applicants", label: "Applicants", admin: true },
  { id: "funnel", href: "/funnel", label: "Funnel", admin: true },
  { id: "inbox", href: "/inbox", label: "Team inbox", admin: true },
];
const isOps = ops.some((o) => o.id === page);
const nav: NavItem[] = [
  ...ops,
  { id: "overview", href: "/", label: "Overview" },
  { id: "lessons", href: "/lessons", label: "Lessons" },
  { id: "readiness", href: "/readiness", label: "Readiness" },
  { id: "security", href: "/security", label: "Security", badge: "approvals" },
  { id: "connect", href: "/connect", label: "Connect AI tool" },
  { id: "messages", href: "/messages", label: "Messages", learner: true },
];
const visibility = (n: NavItem) => ({ "data-admin-only": n.admin ? "" : undefined, "data-learner-only": n.learner ? "" : undefined });
const levels = [
  { value: "simple", label: "Simple", hint: "Plain words. Best if you're new." },
  { value: "tech", label: "Technical", hint: "Exact commands, status codes, and config." },
];
const sectionHead = "flex min-h-9 w-full cursor-pointer items-center gap-1.5 px-3 text-[12px] font-semibold uppercase tracking-[0.08em] text-muted hover:text-ink";
const chevron = "size-3.5 transition in-aria-expanded:rotate-90";
const row = "flex min-h-9 items-center gap-2.5 rounded-lg px-3 text-[14px] text-ink no-underline hover:bg-surface-3/70";
const subHead = "flex min-h-8 w-full cursor-pointer items-center gap-1.5 px-3 text-[13px] font-medium text-muted hover:text-ink";
// The explorer follows the activity bar, like an editor's side bar: Overview shows the
// whole project; every other page shows only its own section, opened.
// On Overview, low-priority groups start closed so only what needs you stands out.
const allSections = [
  // meta: a view-model path (src/scripts/view.ts) shown next to the heading.
  { id: "checks", label: "Checks", meta: "passing", total: "total", open: true },
  { id: "modules", label: "Lessons", meta: "modulesDone", total: "modulesTotal", open: true },
  { id: "accounts", label: "Accounts", meta: "connectedCount", total: "connections.length", open: false },
  { id: "messages", label: "Messages", meta: "", total: "", open: true },
  { id: "ops", label: "Operations", meta: "", total: "", open: true },
];
const focus: Record<PageId, string[]> = {
  overview: ["checks", "modules", "accounts"],
  lessons: ["modules"],
  readiness: ["checks"],
  security: ["accounts"],
  connect: ["accounts"],
  messages: ["messages"],
  inbox: ["ops"],
  applicants: ["ops"],
  funnel: ["ops"],
};
const sections = allSections
  .filter((s) => focus[page].includes(s.id))
  .map((s) => (page === "overview" ? s : { ...s, open: true }));
---
<Base title={`${title} · Launchwright`} noindex>
  <script src="../scripts/app.ts"></script>
  {!isOps && <script src="../scripts/learner.ts"></script>}
  {!isOps && page !== "messages" && <script src="../scripts/chat-box.ts"></script>}
  <div class="app-shell relative flex min-h-svh flex-col bg-canvas lg:h-svh lg:overflow-hidden">
    <!-- Title bar -->
    <header class="sticky top-0 z-30 flex min-h-14 flex-none items-center gap-3 bg-night px-3 text-white lg:static lg:px-4">
      <a href="/" class="logo inline-flex flex-none items-center gap-[0.3em] text-[20px] text-white sm:text-[20px]" aria-label="Launchwright home"><Mark class="h-[0.95em] w-auto" />launchwright</a>
      <span class="hidden truncate text-[14px] text-white/55 md:inline">/ {isOps ? "team" : <span data-bind="crumb">…</span>} / <span class="text-white/85">{title}</span></span>
      <div class="ml-auto flex flex-none items-center gap-2">
        <Dropdown id="level" name="level" label="Explain" options={levels} value="simple" tone="dark" hideLabelBelow="sm" searchPlaceholder="Search levels" size="sm" />
        <ThemeToggle tone="dark" compact />
        <!-- Account (filled in by the worker for the signed-in person) -->
        <div class="relative hidden lg:block" data-popover>
          <button type="button" data-popover-trigger aria-expanded="false" aria-controls="account-menu" aria-label="Account" class="grid size-8 cursor-pointer place-items-center overflow-hidden rounded-full bg-lime text-[12px] font-semibold text-night hover:ring-2 hover:ring-white/40">
            <span data-user-avatar class="grid size-full place-items-center" role="img" aria-label="Account"></span>
          </button>
          <div id="account-menu" data-popover-panel hidden class="absolute right-0 top-[calc(100%+10px)] z-30 w-64 rounded-xl border border-line bg-surface p-2 text-ink shadow-2xl shadow-black/20">
            <p class="px-3 pb-2 pt-1.5"><span class="block truncate font-semibold" data-user-name></span><span class="block truncate text-[14px] text-muted" data-user-login></span></p>
            <form method="post" action="/auth/logout" class="border-t border-line pt-1.5"><button type="submit" class="flex min-h-10 w-full cursor-pointer items-center rounded-xl px-3 text-left text-[15px] font-medium hover:bg-surface-2">Sign out</button></form>
          </div>
        </div>
        <div class="relative lg:hidden" data-popover>
          <button type="button" data-popover-trigger aria-expanded="false" aria-controls="app-menu" aria-label="Menu" class="group grid size-9 cursor-pointer place-items-center rounded-full border border-white/15 bg-white/5 text-white">
            <svg class="size-5 group-aria-expanded:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <svg class="hidden size-5 group-aria-expanded:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
          <nav id="app-menu" data-popover-panel hidden aria-label="Menu" class="absolute right-0 top-[calc(100%+10px)] z-30 flex w-[min(20rem,calc(100vw-2rem))] flex-col gap-1 rounded-2xl border border-line bg-surface p-2.5 text-ink shadow-2xl shadow-black/20">
            <p class="px-3.5 pb-1.5 pt-1 text-[14px] text-muted">{isOps ? "launchwright team" : <span data-bind="title"></span>}</p>
            {nav.map((n) => (
              <>
              {n.id === "overview" && <p data-admin-only class="mt-1 border-t border-line px-3.5 pb-1 pt-2.5 text-[13px] text-muted">Learner view</p>}
              <a href={n.href} {...visibility(n)} aria-current={n.id === page ? "page" : undefined} class="flex min-h-11 items-center justify-between rounded-2xl px-3.5 font-medium text-ink no-underline hover:bg-surface-2 aria-[current=page]:bg-surface-3">
                {n.label}
                {n.badge && <span hidden data-if="approvalBadge" data-bind="approvalBadge" class="grid size-6 place-items-center rounded-full bg-orange text-[13px] font-semibold text-night"></span>}
              </a>
              </>
            ))}
            <div class="mt-1 flex items-center justify-between gap-3 border-t border-line px-3.5 pt-2.5">
              <span class="min-w-0"><span class="block truncate text-[15px] font-semibold" data-user-name></span><span class="block truncate text-[13px] text-muted" data-user-login></span></span>
              <form method="post" action="/auth/logout"><button type="submit" class="btn btn-sm btn-outline">Sign out</button></form>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <div class="flex min-h-0 flex-1">
      <!-- Activity bar -->
      <nav aria-label="Dashboard" class="hidden w-14 flex-none flex-col items-center gap-1 bg-night py-2 lg:flex">
        {nav.map((n) => (
          <>
          {n.id === "overview" && <span data-admin-only class="my-1 h-px w-8 bg-white/15" aria-hidden="true"></span>}
          <a
            href={n.href}
            {...visibility(n)}
            title={n.label}
            aria-current={n.id === page ? "page" : undefined}
            class="relative grid size-11 place-items-center rounded-xl text-white/55 no-underline hover:bg-white/5 hover:text-white aria-[current=page]:bg-white/10 aria-[current=page]:text-white"
          >
            <svg class="size-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[n.id]} /></svg>
            <span class="sr-only">{n.label}</span>
            {n.badge && <span hidden data-if="approvalBadge" data-bind="approvalBadge" class="absolute right-1 top-1 grid size-4 place-items-center rounded-full bg-orange text-[10px] font-bold text-night" aria-hidden="true"></span>}
          </a>
          </>
        ))}
      </nav>

      <!-- Explorer -->
      <aside aria-label="Explorer" class="hidden w-64 flex-none flex-col gap-1 overflow-y-auto border-r border-line bg-canvas py-3 lg:flex">
        <div class="px-4 pb-2">
          {isOps ? (
            <>
              <p class="flex items-center gap-2"><span class="size-2 flex-none rounded-full bg-blue ring-4 ring-blue/15" aria-hidden="true"></span><span class="truncate text-[15px] font-semibold">launchwright team</span></p>
              <p class="mt-1 truncate pl-4 text-[13px] text-muted">Operations · only you can see this</p>
            </>
          ) : (
            <>
          <p class="flex items-center gap-2">
            <span class="size-2 flex-none rounded-full bg-muted ring-4 ring-surface-3" data-class="bg-ok ring-ok-bg:hasProject" aria-hidden="true"></span>
            <span class="truncate text-[15px] font-semibold" data-bind="title">…</span>
          </p>
          <p class="mt-1 truncate pl-4 text-[13px] text-muted"><span data-if="hasProject" hidden data-bind="project.stack"></span><span data-unless="hasProject">No project yet</span></p>
            </>
          )}
        </div>
        {sections.map((s) => (
          <section class="border-t border-line px-1.5 pt-1.5">
            <button type="button" class={sectionHead} aria-expanded={String(s.open)} aria-controls={`exp-${s.id}`} data-collapse={`exp-${s.id}`}>
              <svg class={chevron} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
              {s.label}{s.meta && <span class="ml-auto font-medium normal-case tracking-normal tabular-nums"><span data-bind={s.meta}></span>/<span data-bind={s.total}></span></span>}
            </button>
            <div id={`exp-${s.id}`} hidden={!s.open} class="pb-2">
              {s.id === "checks" && (
                <>
                  <p class="px-3 pb-0.5 pt-1 text-[13px] font-medium text-muted">Needs attention</p>
                  <ul class="flex flex-col" data-each="attention">
                    <template>
                      <li><a class={row} data-class="bg-bad-bg font-medium text-bad:isFail" data-attr="href:href">
                        <span class="size-2 flex-none rounded-full border border-dashed border-muted" data-class="bg-bad border-transparent:isFail;bg-orange border-transparent:isWarn" aria-hidden="true"></span>
                        <span class="truncate" data-bind="title"></span>
                        <span class="ml-auto text-[12px] font-normal" data-bind="statusLabel"></span>
                      </a></li>
                    </template>
                  </ul>
                  <button type="button" class={subHead} aria-expanded="false" aria-controls="exp-passed" data-collapse="exp-passed">
                    <svg class={chevron} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                    Passed<span class="ml-auto tabular-nums" data-bind="passedCount"></span>
                  </button>
                  <ul id="exp-passed" hidden class="flex flex-col" data-each="passed">
                    <template>
                      <li><a class:list={[row, "text-muted"]} data-attr="href:href"><Check class="size-3.5 flex-none" /><span class="truncate" data-bind="title"></span><span class="sr-only">: passed</span></a></li>
                    </template>
                  </ul>
                </>
              )}
              {s.id === "modules" && (
                <ul class="flex flex-col" data-each="modules">
                  <template>
                    <li><a class={row} href="/lessons" data-class="bg-surface-3/70 font-medium:isCurrent;text-muted:isDone" data-attr="aria-current:ariaCurrent">
                      <span data-if="isDone"><Check class="size-3.5 flex-none" /></span>
                      <span data-unless="isDone" class="size-2 flex-none rounded-full border border-muted" data-class="bg-blue border-transparent:isCurrent" aria-hidden="true"></span>
                      <span class="truncate" data-class="text-muted:isNext" data-bind="label"></span>
                      <span data-if="isCurrent" class="ml-auto text-[12px] font-normal text-muted">Now</span>
                    </a></li>
                  </template>
                </ul>
              )}
              {s.id === "messages" && (
                <>
                  <ul class="flex flex-col">
                    {nav.filter((n) => n.id === "messages").map((n) => (
                      <li data-admin-only={n.admin ? "" : undefined}><a class:list={[row, n.id === page && "bg-surface-3/70 font-medium"]} href={n.href} aria-current={n.id === page ? "page" : undefined}>
                        <svg class="size-4 flex-none text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[n.id]} /></svg>
                        <span class="truncate">{n.id === "messages" ? "Talk to the team" : n.label}</span>
                      </a></li>
                    ))}
                  </ul>
                  <p class="px-3 pt-2 text-[13px] text-muted">Or email <a href="mailto:hello@launchwright.app">hello@launchwright.app</a>. A person reads every message.</p>
                </>
              )}
              {s.id === "ops" && (
                <ul class="flex flex-col">
                  {ops.map((n) => (
                    <li><a class:list={[row, n.id === page && "bg-surface-3/70 font-medium"]} href={n.href} aria-current={n.id === page ? "page" : undefined}>
                      <svg class="size-4 flex-none text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[n.id]} /></svg>
                      <span class="truncate">{n.label}</span>
                    </a></li>
                  ))}
                </ul>
              )}
              {s.id === "accounts" && (
                <ul class="flex flex-col" data-each="connections">
                  <template>
                    <li><a class={row} data-attr="href:href"><span class="truncate" data-bind="name"></span><span class="ml-auto text-[12px] text-muted" data-class="text-ok:connected" data-bind="stateLabel"></span></a></li>
                  </template>
                </ul>
              )}
            </div>
          </section>
        ))}
      </aside>

      <!-- Editor column -->
      <div class="flex min-w-0 flex-1 flex-col">
        <!-- Open tabs (JS keeps the list; without JS only the current page shows) -->
        <div class="hidden h-11 flex-none items-stretch overflow-x-auto border-b border-line bg-canvas lg:flex" role="navigation" aria-label="Open pages" data-editor-tabs data-page={page}>
          {nav.map((n) => (
            <div data-tab={n.id} {...visibility(n)} hidden={n.id !== page} data-current={n.id === page ? "" : undefined} class="group flex flex-none items-center border-r border-line text-[14px] data-[current]:bg-surface">
              <a href={n.href} aria-current={n.id === page ? "page" : undefined} class="flex h-full items-center gap-2 pl-4 pr-1 text-muted no-underline aria-[current=page]:font-semibold aria-[current=page]:text-ink">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[n.id]} /></svg>
                {n.label}
              </a>
              <button type="button" data-tab-close={n.id} aria-label={`Close ${n.label}`} class="mr-2 grid size-6 cursor-pointer place-items-center rounded-md text-muted opacity-0 hover:bg-surface-3 hover:text-ink focus-visible:opacity-100 group-hover:opacity-100 group-data-[current]:opacity-100">
                <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
              </button>
            </div>
          ))}
          {!isOps && (
<button type="button" data-collapse="inspector" aria-controls="inspector" aria-expanded="true" aria-label="Show or hide the lesson panel" title="Lesson panel" class="ml-auto mr-2 hidden size-8 flex-none cursor-pointer self-center place-items-center rounded-lg text-muted hover:bg-surface-3 hover:text-ink aria-expanded:text-ink xl:grid">
            <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M15 4v16" /></svg>
          </button>
)}
        </div>

        <main class="@container relative min-h-0 flex-1 bg-surface px-4 pb-6 pt-4 text-[15px] md:px-5 lg:overflow-y-auto lg:pt-5" data-editor data-learner-page={isOps ? undefined : ""}>
          {!isOps && <p id="load-error" hidden role="alert" class="mb-4 rounded-lg bg-warn-bg px-4 py-2.5 text-[14px] text-warn"></p>}
          {!isOps && <p hidden data-if="setupIncomplete" class="mb-4 rounded-lg bg-warn-bg px-4 py-2.5 text-[14px] text-warn">This server isn't fully set up yet (no database or encryption key), so nothing is saved. Real data appears once it is.</p>}
          <slot />
        </main>

        <!-- Bottom panel -->
        {!isOps && (
<section aria-label="Panel" class="hidden flex-none flex-col border-t border-line bg-night text-white lg:flex">
          <div class="flex h-9 items-center gap-1 px-2">
            <div role="tablist" aria-label="Panel" data-tabs class="flex h-full items-stretch">
              <button type="button" role="tab" id="pt-calls" aria-controls="pp-calls" aria-selected="true" class="cursor-pointer border-b-2 border-transparent px-3 text-[12px] font-semibold uppercase tracking-[0.08em] text-white/55 aria-selected:border-lime aria-selected:text-white">Tool calls</button>
              <button type="button" role="tab" id="pt-problems" aria-controls="pp-problems" aria-selected="false" class="flex cursor-pointer items-center gap-2 border-b-2 border-transparent px-3 text-[12px] font-semibold uppercase tracking-[0.08em] text-white/55 aria-selected:border-lime aria-selected:text-white">Problems <span class="grid size-5 place-items-center rounded-full bg-orange text-[11px] tracking-normal text-night" data-bind="attention.length"></span></button>
            </div>
            <span class="ml-3 hidden text-[13px] text-white/45 xl:inline">From your AI tool</span>
            <button type="button" data-collapse="panel-body" aria-controls="panel-body" aria-expanded="true" aria-label="Show or hide the panel" class="ml-auto grid size-8 cursor-pointer place-items-center rounded-lg text-white/60 hover:bg-white/10 hover:text-white">
              <svg class="size-4 rotate-180 transition in-aria-expanded:rotate-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
          </div>
          <div id="panel-body" class="h-28 overflow-y-auto px-4 pb-2 [@media(min-height:1000px)]:h-40">
            <ol id="pp-calls" role="tabpanel" aria-labelledby="pt-calls" class="flex flex-col gap-0.5 text-[13px]" data-each="toolCalls">
              <template>
                <li class="grid grid-cols-[3.5rem_9.5rem_7rem_minmax(0,1fr)] gap-3">
                  <span class="tabular-nums text-white/45" data-bind="time"></span>
                  <span class="text-lime" data-bind="tool"></span>
                  <span class="truncate text-white/55" data-bind="who"></span>
                  <span class="truncate text-white/85" data-class="text-orange:isPending;text-[#ff7a70]:isProblem" data-bind="summary"></span>
                </li>
              </template>
              <li class="mt-1" hidden data-unless="toolCalls"><span class="text-white/55">No tool calls yet. Connect your AI tool and ask it to check your project.</span></li>
              <li class="mt-1"><span class="inline-block h-4 w-2 translate-y-0.5 bg-white/60 motion-safe:animate-pulse" aria-hidden="true"></span><span class="sr-only">Waiting for the next tool call</span></li>
            </ol>
            <ul id="pp-problems" role="tabpanel" aria-labelledby="pt-problems" class="flex flex-col gap-0.5 text-[13px]" data-each="attention">
              <template>
                <li>
                  <a data-attr="href:href" class="grid grid-cols-[1.25rem_minmax(0,1fr)] gap-2 rounded-md px-1 py-0.5 text-white/85 no-underline hover:bg-white/5">
                    <span class="mt-1.5 size-2 rounded-full bg-white/40" data-class="bg-[#ff7a70]:isFail;bg-orange:isWarn" aria-hidden="true"></span>
                    <span><span class="font-semibold text-white" data-bind="title"></span> <span class="text-white/60" data-bind="detail"></span></span>
                  </a>
                </li>
              </template>
            </ul>
          </div>
        </section>
)}
      </div>

      <!-- Lesson panel: the lesson behind your next step. Hide it from the tab bar. -->
      {!isOps && (
<aside id="inspector" aria-labelledby="insp-title" class="hidden w-72 flex-none flex-col gap-4 overflow-y-auto border-l border-line bg-canvas p-4 xl:flex">
        <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-muted">Lesson</p>
        <div class="flex flex-col gap-2 rounded-xl bg-blue p-4 text-white">
          <p class="text-[13px] text-white/75" data-bind="next.module">Your next lesson</p>
          <h2 id="insp-title" class="text-[19px] font-bold leading-tight tracking-[-0.02em]"><span data-if="next" hidden data-bind="next.lesson"></span><span data-unless="next" data-bind="current.name">Getting started</span></h2>
        </div>
        <div>
          <p class="label text-[13px]">Why it matters</p>
          <p class="mt-2 text-[14px]" data-if="next" hidden data-bind="next.lessonFull"></p>
          <p class="mt-2 text-[14px]" data-unless="next">Connect your AI tool and run project_status. Each tool call teaches the concept behind it: the full lesson the first time, one line after that.</p>
        </div>
        <a class="btn btn-sm" href="/lessons">See all lessons</a>
        <p class="text-[13px] text-muted">Lessons run inside your AI tool. Each step explains what changed and why.</p>
      </aside>
)}
    </div>

    <!-- Status bar -->
    <footer class="flex min-h-8 flex-none flex-wrap items-center gap-x-4 gap-y-1 bg-blue px-3 py-1 text-[13px] text-white">
      {isOps ? <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-lime" aria-hidden="true"></span>Operations · team only</span> : (<>
      <span class="flex items-center gap-1.5"><svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="5" r="2" /><circle cx="6" cy="19" r="2" /><circle cx="18" cy="7" r="2" /><path d="M6 7v10M18 9c0 5-12 3-12 8" /></svg><span data-bind="crumb"></span></span>
      <span hidden data-if="project.host" class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-lime" aria-hidden="true"></span><span data-bind="project.host"></span></span>
      <a class="text-white no-underline hover:underline" href="/readiness"><span data-bind="passing"></span>/<span data-bind="total"></span> checks</a>
      <a hidden data-if="hasApprovals" class="text-white no-underline hover:underline" href="/security#approvals" data-bind="approvalsLabel"></a>
      <span class="ml-auto hidden sm:inline" data-bind="mcp.label"></span>
      <span class="hidden sm:inline">Explain: <Explain simple="Simple" tech="Technical" /></span>
    </>)}
    </footer>
    {!isOps && page !== "messages" && <ChatBox />}
  </div>
</Base>

<style is:global>
  /* Dashboard buttons: smaller than the marketing site's.
     In the components layer so utility classes on a button still win. */
  @layer components {
    .app-shell .btn { min-height: 2.25rem; padding-inline: 1rem; gap: 0.375rem; font-size: 14px; }
    .app-shell .btn-sm { min-height: 2rem; padding-inline: 0.75rem; font-size: 13px; }
  }

  /* Platform, light mode: cool grays for hover and selected states, to match the canvas.
     (The marketing site keeps the theme's warm grays. Dark mode is unchanged.) */
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .app-shell { --surface-2: #f9fafb; --surface-3: #e5e7eb; }
  }
  :root[data-theme="light"] .app-shell { --surface-2: #f9fafb; --surface-3: #e5e7eb; }
</style>
