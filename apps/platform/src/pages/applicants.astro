---
// Pilot applicants (team only; the worker returns 404 for everyone else).
import App from "../layouts/App.astro";

import { OPTIONS } from "../../../site/worker/options";
import Dropdown from "../../../../packages/ui/Dropdown.astro";
import { seg, segGroup, control, toolbar, searchIcon } from "../data/ui";

const statuses = [
  { id: "waiting", label: "Waiting" },
  { id: "accepted", label: "Accepted" },
  { id: "all", label: "All" },
];
const columns = [
  { id: "name", label: "Name", hide: "" },
  { id: "email", label: "Email", hide: "hidden @2xl:table-cell" },
  { id: "building", label: "Building", hide: "hidden @4xl:table-cell" },
  { id: "applied", label: "Applied", hide: "hidden @xl:table-cell" },
  { id: "status", label: "Status", hide: "" },
];

const sections = [
  { id: "about", label: "About you" },
  { id: "experience", label: "Experience" },
  { id: "project", label: "Your project" },
  { id: "goals", label: "Goals" },
];
---
<App title="Applicants" page="applicants">
  <script src="../scripts/applicants.ts"></script>
  <div class="flex flex-col gap-4">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="label">Operations</p>
        <h1 class="text-[clamp(1.5rem,2.2vw,1.875rem)] font-bold leading-tight tracking-[-0.02em]">Pilot applicants</h1>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" data-rank class="btn btn-sm btn-outline">Rank with Claude</button>
        <p data-accepted class="tag tag-line text-[14px]" aria-live="polite">Loading…</p>
      </div>
    </div>
    <p data-rank-note role="status" class="-mt-2 text-[13px] text-muted">Ranks everyone waiting by how likely they are to finish the pilot. Claude gets only their answers and project text (contact details removed), never their name, email, GitHub or city. You still decide.</p>

    <!-- Accepted learners: activity, reminders and Claude's recommendations. Claude only recommends;
         removing access is always your click (one person in the sheet, or several with the checkboxes). -->
    <section data-activity hidden aria-label="Learner activity" class="flex flex-col gap-2 rounded-md border border-line bg-surface p-3 dark:bg-surface-2">
      <div class="flex flex-wrap items-center gap-2">
        <p data-activity-summary class="mr-auto text-[14px]" aria-live="polite">Loading activity…</p>
        <button type="button" data-recommend class="btn btn-sm btn-outline">Recommend with Claude</button>
        <button type="button" data-remind class="btn btn-sm btn-outline">Send reminders</button>
      </div>
      <p data-activity-note role="status" class="text-[13px] text-muted">Reminders go only to people stuck before their first readiness check: 2+ days after you accepted them, quiet for 3+ days, at most 3 each and 3 days apart. Claude sees activity counts and their hours and project stage, never names, emails, repos or code.</p>
      <div data-bulk hidden class="flex flex-wrap items-center gap-2 border-t border-line pt-2">
        <p data-bulk-count class="mr-auto text-[14px] font-semibold" aria-live="polite"></p>
        <button type="button" data-select-suggested hidden class="btn btn-sm btn-outline">Select Claude's "consider removing"</button>
        <button type="button" data-bulk-clear class="btn btn-sm btn-outline">Clear</button>
        <button type="button" data-bulk-remove class="btn btn-sm btn-outline">Remove access</button>
      </div>
    </section>

    <!-- One card: toolbar (status, filters, search), then the table. -->
    <!-- No overflow-hidden here: it would clip the filter menus. The toolbar rounds its own top corners. -->
    <div class="rounded-md border border-line bg-surface dark:bg-surface-2">
      <div class:list={[toolbar, "relative z-10 rounded-t-md"]}>
        <div role="group" aria-label="Status" data-filter class={segGroup}>
          {statuses.map((s, i) => (
            <button type="button" data-show={s.id} aria-pressed={i === 0 ? "true" : "false"} class={seg}>{s.label} <span data-count={s.id} class="tabular-nums text-muted"></span></button>
          ))}
        </div>
        <Dropdown id="filter-role" name="applicants-role" label="Role" size="sm" align="left" value="" options={[{ value: "", label: "Any" }, ...OPTIONS.role.map(([value, label]) => ({ value, label }))]} />
        <Dropdown id="filter-stage" name="applicants-stage" label="Stage" size="sm" align="left" value="" options={[{ value: "", label: "Any" }, ...OPTIONS.stage.map(([value, label]) => ({ value, label }))]} />
        <div class="relative ml-auto w-full @2xl:w-64">
          <label class="sr-only" for="applicant-search">Search applicants</label>
          <Fragment set:html={searchIcon} />
          <input id="applicant-search" type="search" data-search placeholder="Search name, email, project…" autocomplete="off" class={`${control} w-full pl-8`} />
        </div>
      </div>
      <div class="overflow-x-auto rounded-b-md">
      <table class="w-full border-collapse text-left text-[14px]">
        <thead class="text-[12px] font-semibold uppercase tracking-[0.06em] text-muted">
          <tr class="border-b border-line">
            <th scope="col" data-select-col hidden class="w-0 py-2 pl-3 @xl:pl-4"><input type="checkbox" data-select-all aria-label="Select everyone shown" class="size-4 accent-ink" /></th>
            {columns.map((c) => (
              <th scope="col" data-col={c.id} aria-sort={c.id === "applied" ? "descending" : undefined} class:list={["px-3 py-2 @xl:px-4 font-semibold", c.hide]}>
                <button type="button" data-sort={c.id} class="group inline-flex items-center gap-1 uppercase tracking-[0.06em] hover:text-ink">
                  {c.label}<span data-sort-icon class="text-[10px] opacity-0 group-hover:opacity-60" aria-hidden="true">▲</span>
                </button>
              </th>
            ))}
            <th scope="col" class="px-3 py-2 @xl:px-4"><span class="sr-only">Details</span></th>
          </tr>
        </thead>
        <tbody data-applicants aria-busy="true" aria-live="polite"></tbody>
      </table>
      </div>
    </div>
  </div>

  <dialog data-sheet aria-labelledby="sheet-title" class="sheet min-h-[60dvh]">
    <div class="mx-auto flex min-h-[60dvh] w-full max-w-3xl flex-col gap-4 px-4 pb-8 pt-3 md:px-8">
      <span class="mx-auto h-1.5 w-12 rounded-full bg-line" aria-hidden="true"></span>
      <div class="flex items-start gap-3">
        <div class="min-w-0 flex-1">
          <h2 id="sheet-title" data-sheet-name class="truncate text-2xl font-bold tracking-[-0.01em]"></h2>
          <p data-sheet-meta class="break-words text-[14px] text-muted"></p>
        </div>
        <span data-sheet-status class="tag flex-none text-[13px]"></span>
        <button type="button" data-sheet-close aria-label="Close" class="grid size-8 flex-none cursor-pointer place-items-center rounded-md border border-line text-xl leading-none hover:border-ink">&times;</button>
      </div>
      <div hidden data-sheet-activity class="flex flex-col gap-1 rounded-lg bg-surface-2 p-3 text-[14px]">
        <p class="flex flex-wrap items-center gap-2"><span data-sheet-stage class="tag text-[12px]"></span><span data-sheet-verdict hidden class="tag text-[12px]"></span></p>
        <p data-sheet-activity-text class="text-muted"></p>
        <p data-sheet-verdict-reason></p>
      </div>
      <div hidden data-sheet-review class="flex flex-col gap-1 rounded-lg bg-surface-2 p-3 text-[14px]">
        <p class="flex items-center gap-2"><span data-sheet-fit class="tag text-[12px]"></span><span class="text-muted">Claude's read</span></p>
        <p data-sheet-reason></p>
        <p data-sheet-risk class="text-muted"></p>
      </div>
      <!-- Same steps as the pilot form (apps/site/src/pages/pilot/apply.astro). -->
      <div class="flex-1">
        <div role="tablist" aria-label="Application" data-tabs class="tabs">
          {sections.map((s, i) => (
            <button type="button" role="tab" id={`sheet-tab-${s.id}`} aria-controls={`sheet-panel-${s.id}`} aria-selected={i === 0 ? "true" : "false"} class="tab">{s.label}</button>
          ))}
        </div>
        {sections.map((s) => (
          <dl id={`sheet-panel-${s.id}`} role="tabpanel" aria-labelledby={`sheet-tab-${s.id}`} data-sheet-section={s.id} class="grid min-h-32 grid-cols-1 content-start gap-x-6 gap-y-1 pt-4 text-[14px] md:grid-cols-[minmax(10rem,auto)_minmax(0,1fr)]"></dl>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-3 border-t border-line pt-4">
        <button type="button" data-sheet-accept class="btn btn-sm"></button>
        <button type="button" data-sheet-remove hidden class="btn btn-sm btn-outline">Remove access</button>
        <p data-sheet-note role="status" class="text-[14px] text-muted"></p>
      </div>
    </div>
  </dialog>
</App>
