---
import App from "../layouts/App.astro";
import Check from "../../../../packages/ui/Check.astro";
import { LEVEL_1 } from "../../../../packages/core/curriculum";

// Level 1 curriculum (packages/core/curriculum.ts) with this learner's progress.
// A concept counts as covered once a tool call has taught it.
---
<App title="Lessons" page="lessons">
  <div class="flex flex-col gap-4">
    <div>
      <p class="label">Lessons · Level 1</p>
      <h1 class="text-[clamp(1.5rem,2.2vw,1.875rem)] font-bold leading-tight tracking-[-0.02em]" data-bind="lessonsHeading">Lessons</h1>
      <p class="mt-1 text-[14px] text-muted">Lessons happen inside your AI tool: every launchwright tool call explains what it did and why. The first time you meet a concept you get the full lesson; after that, one line. <span data-bind="conceptsCovered">0</span> concepts covered and <span data-bind="exercisesDone">0</span> of <span data-bind="exercisesTotal">6</span> practice exercises done so far.</p>
      <p class="mt-1 text-[14px] text-muted">The commands below are for Claude Code: paste one into it as is. In Cursor, Codex and other tools, pick the same lesson (like <code>lesson-practice</code>) from the prompt menu and fill in your repo and the exercise. <a href="/connect#tools-and-prompts">How lessons and tools differ</a></p>
      <p class="mt-1 text-[14px] text-muted"><span class="font-semibold text-ink">{LEVEL_1.promise}</span> Passing the checks is a baseline. The practice exercises cover what no check can verify for you, like a restore drill or testing who can see whose data. An exercise counts once its result is in your repo; that shows the work landed, not that it's perfect. Whether a specific app is production-ready depends on its users, its data and what happens if it fails.</p>
    </div>

    <section hidden data-if="current" class="card rounded-xl grid grid-cols-1 gap-4 bg-surface p-4 @3xl:grid-cols-[minmax(0,1fr)_auto] @3xl:items-end" aria-labelledby="current-title">
      <div>
        <p class="flex items-center gap-2"><span class="tag bg-blue text-white">In progress</span><span class="text-muted">Module <span data-bind="current.n"></span></span></p>
        <h2 id="current-title" class="mt-3 text-3xl font-bold tracking-[-0.02em]" data-bind="current.name"></h2>
        <p class="mt-2 text-base text-muted"><span data-bind="current.blurb"></span> <span data-bind="current.done"></span> of <span data-bind="current.total"></span> done.</p>
        <span class="mt-3 flex h-2 max-w-md gap-1" role="img" data-attr="aria-label:current.ariaLabel" data-each="current.bars">
          <template><i class="flex-1 rounded-full bg-line" data-class="bg-ink:done"></i></template>
        </span>
      </div>
      <div hidden data-if="current.promptCommand" class="flex flex-col gap-1 text-[14px]">
        <span class="text-muted">Guided lesson: in your AI tool, run the prompt</span>
        <code class="text-[15px]" data-bind="current.promptCommand"></code>
      </div>
    </section>

    <ol class="grid grid-cols-1 gap-3 @2xl:grid-cols-2" data-each="modules">
      <template>
        <li class="card rounded-xl flex flex-col gap-3 p-4" data-class="bg-transparent:isNext">
          <div class="flex items-start gap-3">
            <span class="grid size-10 flex-none place-items-center rounded-full border border-line text-[14px] font-semibold text-muted" data-class="bg-ink text-on-ink border-transparent:isDone;bg-blue text-white border-transparent:isCurrent">
              <span data-if="isDone"><Check class="size-4" /></span><span data-unless="isDone" data-bind="n"></span>
            </span>
            <div class="min-w-0 flex-1">
              <p class="text-base font-semibold" data-bind="name"></p>
              <p class="text-muted" data-bind="blurb"></p>
            </div>
            <span class="text-[14px] tabular-nums text-muted" data-bind="count"></span>
          </div>
          <ul class="flex flex-col gap-1 border-t border-line pt-2" data-each="concepts">
            <template>
              <li>
                <details class="group">
                  <summary class="flex cursor-pointer items-center gap-2 py-1 text-[14px]">
                    <span class="size-2 flex-none rounded-full border border-muted" data-class="bg-ok border-transparent:done" aria-hidden="true"></span>
                    <span class="flex-1" data-bind="title"></span>
                    <span class="text-[12px] text-muted" data-bind="state"></span>
                  </summary>
                  <p class="pb-2 pl-4 text-[14px] text-muted" data-bind="full"></p>
                </details>
              </li>
            </template>
          </ul>
          <div hidden data-if="hasExercises" class="flex flex-col gap-1 border-t border-line pt-2">
            <p class="text-[12px] font-semibold uppercase tracking-wide text-muted">Practice on your app</p>
            <ul class="flex flex-col gap-1" data-each="exercises">
              <template>
                <li>
                  <details class="group">
                    <summary class="flex cursor-pointer items-center gap-2 py-1 text-[14px]">
                      <span class="size-2 flex-none rotate-45 border border-muted" data-class="bg-ok border-transparent:done" aria-hidden="true"></span>
                      <span class="flex-1" data-bind="title"></span>
                      <span class="text-[12px] text-muted" data-bind="state"></span>
                    </summary>
                    <p class="pb-1 pl-4 text-[14px] text-muted" data-bind="why"></p>
                    <p class="pb-1 pl-4 text-[13px] text-muted" data-bind="doneWhen"></p>
                    <p class="pb-2 pl-4 text-[13px] text-muted">Start it in Claude Code: <code class="[overflow-wrap:anywhere]" data-bind="command"></code></p>
                  </details>
                </li>
              </template>
            </ul>
          </div>
          <p hidden data-if="promptCommand" class="text-[13px] text-muted">Guided lesson in Claude Code: <code class="[overflow-wrap:anywhere]" data-bind="promptCommand"></code></p>
        </li>
      </template>
    </ol>

    <div class="card rounded-xl flex flex-wrap items-center justify-between gap-3 bg-transparent p-4">
      <p><span class="font-semibold">Level 2 · Your own VPS.</span> <span class="text-muted">Linux, SSH, Nginx, Docker, TLS, backups. Unlocks after Level 1.</span></p>
      <span class="tag tag-line">Later</span>
    </div>
  </div>
</App>
