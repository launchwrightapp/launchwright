---
import App from "../layouts/App.astro";
import Check from "../../../../packages/ui/Check.astro";
import { modules, modulesDone, conceptsCovered } from "../data/sample";

const current = modules.find((m) => m.status === "current")!;
---
<App title="Lessons" page="lessons">
  <div class="flex flex-col gap-4">
    <div>
      <p class="label">Lessons · Level 1</p>
      <h1 class="text-[clamp(1.5rem,2.2vw,1.875rem)] font-bold leading-tight tracking-[-0.02em]">{modulesDone} of {modules.length} modules done</h1>
    </div>

    <section class="card rounded-xl grid grid-cols-1 gap-4 bg-surface p-4 @3xl:grid-cols-[minmax(0,1fr)_auto] @3xl:items-end" aria-labelledby="current-title">
      <div>
        <p class="flex items-center gap-2"><span class="tag bg-blue text-white">In progress</span><span class="text-muted">Module {current.n}</span></p>
        <h2 id="current-title" class="mt-3 text-3xl font-bold tracking-[-0.02em]">{current.name}</h2>
        <p class="mt-2 text-base text-muted">{current.blurb} {current.concepts} of {current.total} concepts done.</p>
        <div class="mt-3 grid h-2 max-w-md grid-cols-4 gap-1" role="img" aria-label={`${current.concepts} of ${current.total} concepts`}>
          {Array.from({ length: current.total }, (_, i) => <i class:list={["rounded-full", i < current.concepts ? "bg-ink" : "bg-line"]}></i>)}
        </div>
      </div>
      <a class="btn btn-sm" href="#">Continue: Auth on API routes</a>
    </section>

    <ol class="grid grid-cols-1 gap-3 @2xl:grid-cols-2">
      {modules.map((m) => (
        <li class:list={["card rounded-xl flex items-start gap-3 p-4", m.status === "next" && "bg-transparent"]}>
          <span class:list={["grid size-10 flex-none place-items-center rounded-full text-[14px] font-semibold", m.status === "done" ? "bg-ink text-on-ink" : m.status === "current" ? "bg-blue text-white" : "border border-line text-muted"]}>
            {m.status === "done" ? <Check class="size-4" /> : m.n}
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-base font-semibold">{m.name}</p>
            <p class="text-muted">{m.blurb}</p>
          </div>
          <span class="text-[14px] tabular-nums text-muted">{m.concepts}/{m.total}</span>
        </li>
      ))}
    </ol>

    <div class="card rounded-xl flex flex-wrap items-center justify-between gap-3 bg-transparent p-4">
      <p><span class="font-semibold">Level 2 · Your own VPS.</span> <span class="text-muted">Linux, SSH, Nginx, Docker, TLS, backups. Unlocks after Level 1.</span></p>
      <span class="tag tag-line">Later</span>
    </div>
  </div>
</App>
