---
// Public sign-in page. The worker (worker/index.ts) sends signed-out visitors here.
import Base from "../../../../packages/ui/Base.astro";
import ThemeToggle from "../../../../packages/ui/ThemeToggle.astro";
---
<Base title="Sign in · Launchwright" noindex>
  <script src="../scripts/signin.ts"></script>
  <div class="flex min-h-svh flex-col bg-canvas">
    <header class="flex h-14 items-center justify-between bg-night px-4 text-white">
      <a href="https://launchwright.app" class="logo text-[20px] text-white" aria-label="Launchwright home">launchwright</a>
      <ThemeToggle tone="dark" compact />
    </header>

    <main class="grid flex-1 place-items-center px-4 py-12">
      <div class="w-full max-w-[420px] overflow-hidden rounded-[22px] border border-line bg-surface shadow-2xl shadow-black/10 dark:bg-surface-2">
        <!-- Editor-style tab, like the dashboard -->
        <div class="flex h-10 items-stretch border-b border-line bg-canvas">
          <span class="flex items-center gap-2 border-r border-t-2 border-line border-t-blue bg-surface px-4 text-[13px] font-semibold dark:bg-surface-2">sign-in</span>
        </div>
        <div class="flex flex-col gap-5 p-7">
          <div>
            <h1 class="text-[28px] font-bold leading-tight tracking-[-0.03em]">Sign in to launchwright</h1>
            <p class="mt-2 text-muted">Use your GitHub account. It's where your code lives, so it's where we start.</p>
          </div>

          <p id="signin-message" role="status" hidden class="rounded-2xl bg-warn-bg px-4 py-3 text-[15px] text-warn"></p>

          <a href="/auth/github" data-signin class="btn w-full gap-3">
            <svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
            Continue with GitHub
          </a>

          <ul class="flex flex-col gap-2 border-t border-line pt-5 text-[14px] text-muted">
            <li class="flex gap-2"><span class="mt-2 size-1.5 flex-none rounded-full bg-ok" aria-hidden="true"></span>We only read your public GitHub profile: name, username, and picture.</li>
            <li class="flex gap-2"><span class="mt-2 size-1.5 flex-none rounded-full bg-ok" aria-hidden="true"></span>No access to your code until you connect a repo yourself.</li>
            <li class="flex gap-2"><span class="mt-2 size-1.5 flex-none rounded-full bg-blue" aria-hidden="true"></span>The dashboard shows sample data while v0.1 is in development.</li>
          </ul>
        </div>
      </div>
    </main>

    <footer class="flex flex-wrap justify-center gap-x-4 gap-y-1 px-4 pb-6 text-[13px] text-muted">
      <a class="text-muted hover:text-ink" href="https://launchwright.app/privacy">Privacy</a>
      <a class="text-muted hover:text-ink" href="https://launchwright.app/terms">Terms</a>
      <a class="text-muted hover:text-ink" href="https://github.com/launchwrightapp/launchwright">Source (AGPL-3.0)</a>
    </footer>
  </div>
</Base>
