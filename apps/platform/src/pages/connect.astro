---
import App from "../layouts/App.astro";
import Explain from "../components/Explain.astro";
import CopyBox from "../components/CopyBox.astro";

// Sample: the MCP server isn't live yet. URL and commands show the planned setup.
const url = "https://mcp.launchwright.app/mcp";
const tools = [
  { id: "claude", label: "Claude Code", where: "In your project folder, in the terminal:", text: `claude mcp add --transport http launchwright ${url}` },
  { id: "cursor", label: "Cursor", where: "Add this to .cursor/mcp.json in your project:", text: `{ "mcpServers": { "launchwright": { "url": "${url}" } } }` },
  { id: "codex", label: "Codex", where: "Add this to ~/.codex/config.toml:", text: `[mcp_servers.launchwright] url = "${url}"` },
];
const steps = [
  { t: "Add Launchwright to your AI tool", d: "One line. Pick your tool below." },
  { t: "Sign in when it asks", d: "A browser window opens. Sign in with GitHub." },
  { t: "Ask it to check your project", d: "Try: \"Use launchwright to check my project\"." },
];
---
<App title="Connect AI tool" page="connect">
  <div class="flex flex-col gap-4">
    <div>
      <p class="flex items-center gap-2"><span class="label">Connect AI tool</span><span class="tag tag-line">Sample</span></p>
      <h1 class="text-[clamp(1.75rem,3vw,2.5rem)] font-bold leading-tight tracking-[-0.02em]">Keep using the AI tool you have</h1>
      <p class="mt-1 max-w-[70ch] text-muted">
        <Explain simple="Launchwright plugs into Claude Code, Cursor, or Codex. You keep your own subscription. We add the lessons and the safety checks." tech={`Remote MCP server over Streamable HTTP at ${url}. OAuth 2.1 sign-in; tools: project_status, check_readiness, deploy, set_secret, get_logs, and more.`} />
      </p>
    </div>

    <ol class="grid grid-cols-1 gap-3 @3xl:grid-cols-3">
      {steps.map((s, i) => (
        <li class="card rounded-xl flex flex-col gap-1.5 p-5">
          <span class="grid size-9 place-items-center rounded-full bg-ink text-[15px] font-semibold text-on-ink">{i + 1}</span>
          <p class="text-lg font-semibold">{s.t}</p>
          <p class="text-muted">{s.d}</p>
        </li>
      ))}
    </ol>

    <div class="card rounded-xl p-0">
      <div role="tablist" aria-label="AI tool" data-tabs class="flex gap-1 overflow-x-auto border-b border-line px-4 pt-3">
        {tools.map((t, i) => (
          <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? "true" : "false"} class="min-h-12 flex-none cursor-pointer border-b-2 border-transparent px-4 font-semibold text-muted aria-selected:border-ink aria-selected:text-ink">{t.label}</button>
        ))}
      </div>
      {tools.map((t) => (
        <div id={`panel-${t.id}`} role="tabpanel" aria-labelledby={`tab-${t.id}`} class="flex flex-col gap-4 p-5">
          <CopyBox label={t.where} text={t.text} />
          <p class="text-[15px] text-muted">Then restart {t.label}. You'll see <code>launchwright</code> in its list of tools.</p>
        </div>
      ))}
    </div>

    <div class="card rounded-xl flex flex-wrap items-center justify-between gap-4 p-6">
      <div>
        <p class="text-lg font-semibold">Waiting for your first connection</p>
        <p class="text-muted">This page updates on its own once your AI tool connects.</p>
      </div>
      <span class="tag tag-line"><span class="size-2 rounded-full bg-muted" aria-hidden="true"></span>Not connected yet</span>
    </div>
  </div>
</App>
