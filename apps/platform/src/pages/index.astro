---
import App from "../layouts/App.astro";
import Check from "../../../../packages/ui/Check.astro";

// Overview answers three questions, in this order:
// 1. Now: what's blocking me and what do I do next? (For a new learner: the setup steps.)
// 2. Progress: how far along are the project and I? (And anything waiting for approval.)
// 3. History: what happened recently? (The raw tool log is in the bottom panel.)
// Everything is filled in from /api/me by src/scripts/learner.ts.
const card = "rounded-xl border border-line bg-surface p-4 dark:bg-surface-2";
const level = "text-[12px] font-semibold uppercase tracking-[0.08em] text-muted";
const stat = "group flex h-full flex-col gap-1 rounded-xl border border-line bg-surface px-4 py-2.5 text-ink no-underline transition hover:border-ink/30 dark:bg-surface-2";
const kinds = [
  { id: "all", label: "All" },
  { id: "action", label: "AI actions" },
  { id: "approval", label: "Approvals" },
  { id: "problem", label: "Problems" },
  { id: "you", label: "You" },
];
---
<App title="Overview" page="overview">
  <div class="flex flex-col gap-4">
    <!-- Project identity -->
    <div>
      <p class="text-muted"><span data-bind="greeting">Hello</span>, <span data-user-first>there</span>.</p>
      <h1 class="mt-0.5 text-[clamp(1.5rem,2.2vw,1.875rem)] font-bold leading-tight tracking-[-0.03em]" data-bind="title">launchwright</h1>
      <p hidden data-if="hasProject" class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[14px] text-muted">
        <a class="text-muted" data-attr="href:project.githubUrl" data-bind="project.repo"></a><span aria-hidden="true">·</span>
        <span data-bind="project.stack"></span><span aria-hidden="true">·</span>
        <span data-bind="project.checkedAgo"></span>
        <span hidden data-if="project.host" class="flex items-center gap-1.5 text-ok"><span class="size-2 rounded-full bg-ok" aria-hidden="true"></span><span data-bind="project.host"></span></span>
      </p>
    </div>

    <!-- First run: setup checklist -->
    <section hidden data-if="showOnboarding" class={card} aria-labelledby="setup-title">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="setup-title" class="text-base font-semibold">Get set up</h2>
        <span class="text-[14px] text-muted" data-bind="setupHeading"></span>
      </div>
      <p class="mt-1 text-[14px] text-muted">About 10 minutes. You keep your own AI tool and your own free accounts; launchwright never sees your keys' values.</p>
      <ol class="mt-3 grid grid-cols-1 gap-2 @3xl:grid-cols-2" data-each="onboarding">
        <template>
          <li class="flex items-start gap-3 rounded-lg border border-line p-3" data-attr="aria-label:label">
            <span class="grid size-8 flex-none place-items-center rounded-full border border-line text-[13px] font-semibold" data-class="bg-ok border-transparent text-white:done">
              <span data-if="done"><Check class="size-4" /></span><span data-unless="done" data-bind="n"></span>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-semibold" data-class="text-muted line-through:done" data-bind="title"></span>
              <span class="block text-[14px] text-muted" data-bind="detail"></span>
            </span>
            <a data-if="todo" class="btn btn-sm btn-outline flex-none" data-attr="href:href" data-bind="cta"></a>
          </li>
        </template>
      </ol>
    </section>

    <!-- Level 1: Now -->
    <section class="flex flex-col gap-3" aria-labelledby="now-title">
      <h2 id="now-title" class={level}>Now</h2>

      <ul class="grid grid-cols-1 gap-2 @xl:grid-cols-2 @3xl:grid-cols-4">
        <li>
          <a class={stat} href="/readiness">
            <span class="text-[14px] text-muted">Readiness</span>
            <span class="text-[22px] font-bold leading-none tracking-[-0.02em] tabular-nums"><span data-bind="passing">0</span><span class="text-muted">/<span data-bind="total">8</span></span></span>
            <span class="text-[14px] text-muted">checks passed</span>
          </a>
        </li>
        <li>
          <a class={stat} href="#next-up">
            <span class="flex items-center justify-between gap-2 text-[14px] text-muted">Blocking <span hidden data-if="next.isFail" class="tag tag-bad py-0 text-[12px]">Failed</span><span hidden data-if="next.isWarn" class="tag tag-warn py-0 text-[12px]">Needs work</span></span>
            <span class="text-[16px] font-semibold leading-snug"><span hidden data-if="next" data-bind="next.title"></span><span data-unless="next">Nothing</span></span>
            <span class="text-[14px] text-muted"><span hidden data-if="next">Fix this first</span><span data-unless="next">No failing checks</span></span>
          </a>
        </li>
        <li>
          <a class={stat} href="#approvals">
            <span class="flex items-center justify-between gap-2 text-[14px] text-muted">Waiting for you <span class="tag tag-line py-0 text-[12px]" data-class="tag-warn:hasApprovals" data-bind="approvalCount">0</span></span>
            <span class="text-[16px] font-semibold leading-snug"><span hidden data-if="hasApprovals" data-bind="approvals.0.title"></span><span data-unless="hasApprovals">No approvals</span></span>
            <span class="text-[14px] text-muted"><span hidden data-if="hasApprovals">Asked <span data-bind="approvals.0.asked"></span></span><span data-unless="hasApprovals">You'll be asked before anything risky</span></span>
          </a>
        </li>
        <li>
          <a class={stat} href="/security#accounts">
            <span class="text-[14px] text-muted">Accounts</span>
            <span class="text-[22px] font-bold leading-none tracking-[-0.02em] tabular-nums"><span data-bind="connectedCount">0</span><span class="text-muted">/<span data-bind="connections.length">3</span></span></span>
            <span class="text-[14px] text-muted">connected</span>
          </a>
        </li>
      </ul>

      <!-- The one thing to do next -->
      <section id="next-up" hidden data-if="next" class="grid scroll-mt-4 grid-cols-1 gap-4 rounded-xl bg-blue p-4 text-white @4xl:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] @4xl:p-5" aria-labelledby="next-title">
        <div class="flex flex-col gap-3">
          <p class="flex flex-wrap items-center gap-2">
            <span class="tag bg-white text-night">Next up</span>
            <span class="text-[14px] text-white/75" data-bind="next.module"></span>
          </p>
          <h3 id="next-title" class="text-[clamp(1.375rem,2.2vw,1.75rem)] font-bold leading-tight tracking-[-0.02em]" data-bind="next.heading"></h3>
          <p class="text-white/90" data-bind="next.detail"></p>
          <p class="text-[14px] text-white/75"><b class="font-semibold text-white">Why it matters:</b> <span data-bind="next.why"></span></p>
        </div>
        <div class="flex flex-col gap-3">
          <div class="min-w-0">
            <p class="mb-2 text-[15px] font-medium text-white/75">Paste this into your AI tool</p>
            <div class="flex items-center gap-2 rounded-lg border border-white/15 bg-white/10 py-2 pl-4 pr-2 text-white">
              <code class="min-w-0 flex-1 [overflow-wrap:anywhere] bg-transparent p-0 py-1 text-[16px]" data-copy-text data-bind="next.prompt"></code>
              <button type="button" data-copy hidden class="inline-flex min-h-8 flex-none cursor-pointer items-center rounded-md border border-white/25 px-3 text-[13px] font-semibold text-white hover:bg-white/10">Copy</button>
            </div>
          </div>
          <div class="flex flex-wrap gap-2">
            <a class="btn btn-sm border-white bg-white text-night hover:bg-white/90" href="/lessons">See the lesson</a>
            <a class="btn btn-sm border-white/30 bg-transparent text-white hover:bg-white/10" data-attr="href:next.href">View the check</a>
          </div>
        </div>
      </section>
      <p hidden data-if="allPassing" class="rounded-xl bg-ok-bg px-4 py-3 text-ok">Every check passes. Keep it that way: CI runs them on every push. Next, try a break-and-fix lesson or invite a friend to review your app.</p>
    </section>

    <!-- Level 2: Progress (and the approvals holding things up) -->
    <section class="flex flex-col gap-3" aria-labelledby="progress-title">
      <h2 id="progress-title" class={level}>Progress</h2>
      <div class="grid grid-cols-1 gap-3 @3xl:grid-cols-2 @6xl:grid-cols-3">
        <!-- Approvals -->
        <div id="approvals" class:list={[card, "scroll-mt-4 @3xl:col-span-2 @6xl:col-span-1"]} data-class="border-orange/40:hasApprovals">
          <div class="flex items-center justify-between gap-3">
            <h3 class="text-base font-semibold">Needs your approval</h3>
            <span class="tag tag-line" data-class="tag-warn:hasApprovals" data-bind="approvalCount">0</span>
          </div>
          <p data-unless="hasApprovals" class="mt-1.5 text-[14px] text-muted">Nothing waiting. Production deploys, rollbacks and replacing a secret always stop here first, so one bad prompt can't change production.</p>
          <ul class="mt-2 flex flex-col gap-3" data-each="approvals">
            <template>
              <li class="flex flex-col gap-2 border-t border-line pt-3 first:border-t-0 first:pt-0">
                <p class="text-[16px] font-semibold tracking-[-0.01em]" data-bind="title"></p>
                <p class="text-[14px] text-muted">Asked by <b class="text-ink" data-bind="askedBy"></b> via <code data-bind="tool"></code> · <span data-bind="asked"></span></p>
                <dl class="flex flex-col gap-2 text-[14px]">
                  <div><dt class="font-semibold">If you approve</dt><dd class="text-muted" data-bind="summary"></dd></div>
                  <div><dt class="font-semibold">Why we ask</dt><dd class="text-muted">It changes what your users see, or it can't be undone. Your AI tool can run it once after you approve, and it's saved to your audit log.</dd></div>
                </dl>
                <details class="text-[14px]"><summary class="cursor-pointer font-medium">Inspect change</summary><pre class="term mt-2 overflow-x-auto rounded-lg bg-warn-bg px-4 py-2.5 text-warn" data-bind="detailText"></pre></details>
                <div class="flex flex-wrap gap-2">
                  <button class="btn btn-sm flex-1" type="button" data-decision="approve" data-attr="data-approval:id;data-status:approveId">Approve</button>
                  <button class="btn btn-sm btn-outline flex-1" type="button" data-decision="reject" data-attr="data-approval:id;data-status:approveId">Reject</button>
                </div>
                <p class="text-[14px] text-muted empty:hidden" role="status" data-attr="id:approveId"></p>
              </li>
            </template>
          </ul>
        </div>

        <!-- Readiness -->
        <div class={card}>
          <div class="flex items-start justify-between gap-3">
            <h3 id="checks-title" class="text-base font-semibold">Readiness checks</h3>
            <a class="text-[14px] font-medium text-muted hover:text-ink" href="/readiness">All details</a>
          </div>
          <p class="mt-2.5 flex flex-wrap gap-1.5">
            <span class="tag tag-ok"><Check class="size-3.5" /><span data-bind="passing">0</span> passed</span>
            <span class="tag tag-bad"><span data-bind="failing">0</span> failed</span>
            <span class="tag tag-warn"><span data-bind="warning">0</span> need work</span>
            <span class="tag tag-line"><span data-bind="notChecked">8</span> not checked</span>
          </p>
          <ul class="mt-3 grid grid-cols-8 gap-1 @2xl:gap-2" aria-labelledby="checks-title" data-each="checks">
            <template>
              <li>
                <a class="group flex flex-col items-center gap-2 text-ink no-underline" data-attr="href:href;aria-label:ariaLabel">
                  <span class="block h-12 w-full max-w-7 rounded-full border-2 border-dashed border-line transition group-hover:opacity-80" data-class="bg-ok border-transparent:isPass;bg-bad border-transparent:isFail;bg-orange border-transparent:isWarn"></span>
                  <span class="w-full truncate text-center text-[11px] text-muted @2xl:text-[12px]" data-bind="short"></span>
                </a>
              </li>
            </template>
          </ul>
        </div>

        <!-- Lessons -->
        <div class={card}>
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-base font-semibold">Lesson progress</h3>
              <p class="text-[14px] text-muted"><span data-bind="modulesDone">0</span> of <span data-bind="modulesTotal">8</span> Level 1 modules · <span data-bind="conceptsCovered">0</span> concepts covered</p>
            </div>
            <a class="text-[14px] font-medium text-muted hover:text-ink" href="/lessons">Lessons</a>
          </div>
          <ul class="mt-3 flex flex-col gap-2" data-each="modules">
            <template>
              <li class="grid grid-cols-[7.5rem_minmax(0,1fr)_2.25rem] items-center gap-3">
                <span class="truncate text-[14px] text-ink" data-class="text-muted:isNext;font-semibold:isCurrent" data-bind="name"></span>
                <span class="flex h-2 gap-1" role="img" data-attr="aria-label:ariaLabel" data-each="bars">
                  <template><i class="flex-1 rounded-full bg-line" data-class="bg-blue:doneCurrent;bg-ok:doneOther"></i></template>
                </span>
                <span class="text-right text-[13px] tabular-nums text-muted" data-bind="count"></span>
              </li>
            </template>
          </ul>
        </div>
      </div>
    </section>

    <!-- Level 3: History -->
    <section class="flex flex-col gap-3" aria-labelledby="history-title">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="history-title" class={level}>Recent activity</h2>
        <div class="tabs" role="group" aria-label="Filter activity" data-filter="activity-list">
          {kinds.map((k) => (
            <button type="button" data-kind={k.id} aria-pressed={k.id === "all" ? "true" : "false"} class="tab">{k.label}</button>
          ))}
        </div>
      </div>
      <div class="rounded-xl border border-line bg-surface dark:bg-surface-2">
        <ol id="activity-list" class="flex flex-col" data-each="recent">
          <template>
            <li class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-3 border-t border-line px-4 py-2.5 first:border-t-0" data-attr="data-kind:kind">
              <span class="mt-2 size-2 rounded-full bg-ok" data-class="bg-orange:isPending;bg-bad:isProblem;bg-blue:isYou" aria-hidden="true"></span>
              <span><b class="font-semibold" data-bind="who"></b> · <code data-bind="tool"></code> <span data-bind="summary"></span></span>
              <span class="text-[14px] tabular-nums text-muted" data-bind="ago"></span>
            </li>
          </template>
        </ol>
        <p data-unless="hasAudit" class="px-4 py-2.5 text-[14px] text-muted">Nothing yet. Every tool call your AI tool makes, and every decision you make here, shows up in this list.</p>
        <p data-filter-empty hidden class="px-4 py-2.5 text-[14px] text-muted">Nothing here yet.</p>
      </div>
      <p class="hidden text-[14px] text-muted lg:block">The exact tool calls are in the panel below; the full audit log is on the Security page.</p>
    </section>
  </div>
</App>
