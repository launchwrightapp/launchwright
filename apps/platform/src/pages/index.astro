---
import App from "../layouts/App.astro";
import Explain from "../components/Explain.astro";
import CopyBox from "../components/CopyBox.astro";
import Check from "../../../../packages/ui/Check.astro";
import { project, checks, passing, modules, modulesDone, conceptsCovered, connections, approval, checkShort, events, lesson } from "../data/sample";
import type { EventKind } from "../data/sample";

// Overview answers three questions, in this order:
// 1. Now: what's blocking me and what do I do next?
// 2. Progress: how far along are the project and I?
// 3. History: what happened recently? (The raw tool log is in the bottom panel.)
const next = checks.find((c) => c.status === "fail")!;
const failing = checks.filter((c) => c.status === "fail").length;
const notStarted = checks.filter((c) => c.status === "pending").length;
const connected = connections.filter((c) => c.on).length;

// Tailwind only generates classes it can see written out in full.
const cols: Record<number, string> = { 3: "grid-cols-3", 4: "grid-cols-4", 8: "grid-cols-8" };
const card = "rounded-[22px] border border-line bg-surface p-5 dark:bg-surface-2";
const level = "text-[12px] font-semibold uppercase tracking-[0.08em] text-muted";
const stat = "group flex h-full flex-col gap-1 rounded-[20px] border border-line bg-surface px-4 py-3.5 text-ink no-underline transition hover:border-ink/30 dark:bg-surface-2";
const kinds: { id: EventKind | "all"; label: string }[] = [
  { id: "all", label: "All" },
  { id: "action", label: "Actions" },
  { id: "approval", label: "Approvals" },
  { id: "problem", label: "Problems" },
  { id: "lesson", label: "Lessons" },
];
const kindDot: Record<EventKind, string> = { action: "bg-ok", approval: "bg-orange", problem: "bg-bad", lesson: "bg-blue" };
const kindName: Record<EventKind, string> = { action: "Action", approval: "Approval", problem: "Problem", lesson: "Lesson" };
---
<App title="Overview" page="overview">
  <div class="flex flex-col gap-6">
    <!-- Project identity -->
    <div>
      <p class="text-muted">Good afternoon, {project.user.first}.</p>
      <h1 class="mt-0.5 text-[clamp(1.75rem,3vw,2.5rem)] font-bold leading-tight tracking-[-0.03em]">{project.name}</h1>
      <p class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[15px] text-muted">
        <span>{project.framework}</span><span aria-hidden="true">·</span>
        <span>{project.branch}</span><span aria-hidden="true">·</span>
        <span>{project.stack}</span><span aria-hidden="true">·</span>
        <span class="flex items-center gap-1.5 text-ok"><span class="size-2 rounded-full bg-ok" aria-hidden="true"></span>{project.preview}</span>
        <span class="tag tag-line ml-1 py-0 text-[12px]">Sample data</span>
      </p>
    </div>

    <!-- Level 1: Now -->
    <section class="flex flex-col gap-3" aria-labelledby="now-title">
      <h2 id="now-title" class={level}>Now</h2>

      <ul class="grid grid-cols-1 gap-2 @xl:grid-cols-2 @3xl:grid-cols-4">
        <li>
          <a class={stat} href="/readiness">
            <span class="text-[14px] text-muted">Readiness</span>
            <span class="text-[26px] font-bold leading-none tracking-[-0.02em] tabular-nums">{passing}<span class="text-muted">/{checks.length}</span></span>
            <span class="text-[14px] text-muted">checks passed</span>
          </a>
        </li>
        <li>
          <a class={stat} href="#next-up">
            <span class="flex items-center justify-between gap-2 text-[14px] text-muted">Blocking <span class="tag tag-bad py-0 text-[12px]">Failed</span></span>
            <span class="text-[16px] font-semibold leading-snug">{next.name}</span>
            <span class="text-[14px] text-muted">Fix this first</span>
          </a>
        </li>
        <li>
          <a class={stat} href="#approval">
            <span class="flex items-center justify-between gap-2 text-[14px] text-muted">Waiting for you <span class="tag tag-warn py-0 text-[12px]">1</span></span>
            <span class="text-[16px] font-semibold leading-snug">{approval.title}</span>
            <span class="text-[14px] text-muted">Asked {approval.ago}</span>
          </a>
        </li>
        <li>
          <a class={stat} href="/security">
            <span class="text-[14px] text-muted">Accounts</span>
            <span class="text-[26px] font-bold leading-none tracking-[-0.02em] tabular-nums">{connected}<span class="text-muted">/{connections.length}</span></span>
            <span class="text-[14px] text-muted">connected</span>
          </a>
        </li>
      </ul>

      <!-- The one thing to do next -->
      <section id="next-up" class="grid scroll-mt-4 grid-cols-1 gap-5 rounded-[24px] bg-blue p-5 text-white @4xl:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] @4xl:p-6" aria-labelledby="next-title">
        <div class="flex flex-col gap-3">
          <p class="flex flex-wrap items-center gap-2">
            <span class="tag bg-white text-night">Next up</span>
            <span class="text-[14px] text-white/75">Module {lesson.module} · {lesson.area} · ~{lesson.minutes} min lesson</span>
          </p>
          <h3 id="next-title" class="text-[clamp(1.375rem,2.2vw,1.75rem)] font-bold leading-tight tracking-[-0.02em]">Fix {next.name.replace(/^./, (c) => c.toLowerCase())}</h3>
          <p class="text-white/90"><Explain simple={next.simple} tech={next.tech} /></p>
          <p class="text-[15px] text-white/75"><b class="font-semibold text-white">Why it matters:</b> {next.why}</p>
        </div>
        <div class="flex flex-col gap-3">
          <CopyBox tone="dark" label="Paste this into your AI tool" text={next.fix!.prompt} />
          <div class="flex flex-wrap gap-2">
            <a class="btn btn-sm border-white bg-white text-night hover:bg-white/90" href="/lessons">Start the lesson</a>
            <a class="btn btn-sm border-white/30 bg-transparent text-white hover:bg-white/10" href={`/readiness#check-${next.id}`}>View the check</a>
          </div>
        </div>
      </section>
    </section>

    <!-- Level 2: Progress (and the approval that's holding things up) -->
    <section class="flex flex-col gap-3" aria-labelledby="progress-title">
      <h2 id="progress-title" class={level}>Progress</h2>
      <div class="grid grid-cols-1 gap-3 @3xl:grid-cols-2 @6xl:grid-cols-3">
        <!-- Approval -->
        <div id="approval" class:list={[card, "scroll-mt-4 border-orange/40 @3xl:col-span-2 @6xl:col-span-1"]}>
          <div class="flex items-center justify-between gap-3">
            <h3 class="text-lg font-semibold">Needs your approval</h3>
            <span class="tag tag-warn">Waiting · {approval.ago}</span>
          </div>
          <p class="mt-2 text-[18px] font-semibold tracking-[-0.01em]">{approval.title}</p>
          <p class="text-[15px] text-muted">Asked by <b class="text-ink">{approval.client}</b> via <code>{approval.tool}</code></p>
          <dl class="mt-3 flex flex-col gap-2.5 text-[15px]">
            <div><dt class="font-semibold">What it does</dt><dd class="text-muted"><Explain simple={approval.simple} tech={approval.tech} /></dd></div>
            <div><dt class="font-semibold">Why we ask</dt><dd class="text-muted">It deletes data. Launchwright always asks you before anything that can't be undone.</dd></div>
            <div><dt class="font-semibold">If you approve</dt><dd class="text-muted">The change runs on production and is saved to your audit log.</dd></div>
          </dl>
          <pre id="approval-diff" hidden class="term mt-3 rounded-xl bg-warn-bg px-4 py-3 text-warn">{approval.diff}</pre>
          <div class="mt-3 flex flex-wrap gap-2">
            <button class="btn btn-sm flex-1" type="button" value="approve" data-decide="decision-status">Approve</button>
            <button class="btn btn-sm btn-outline flex-1" type="button" data-toggle="approval-diff" aria-controls="approval-diff" aria-expanded="false">Inspect change</button>
            <button class="btn btn-sm btn-outline flex-1" type="button" value="reject" data-decide="decision-status">Reject</button>
          </div>
          <p id="decision-status" class="mt-3 text-[15px] text-muted empty:hidden" role="status"></p>
        </div>

        <!-- Readiness -->
        <div class={card}>
          <div class="flex items-start justify-between gap-3">
            <h3 id="checks-title" class="text-lg font-semibold">Readiness checks</h3>
            <a class="text-[15px] font-medium text-muted hover:text-ink" href="/readiness">All details</a>
          </div>
          <p class="mt-2.5 flex flex-wrap gap-1.5">
            <span class="tag tag-ok"><Check class="size-3.5" />{passing} passed</span>
            <span class="tag tag-bad">{failing} failed</span>
            <span class="tag tag-line">{notStarted} not started</span>
          </p>
          <ul class:list={["mt-4 grid gap-1 @2xl:gap-2", cols[8]]} aria-labelledby="checks-title">
            {checks.map((c) => (
              <li>
                <a href={`/readiness#check-${c.id}`} class="group flex flex-col items-center gap-2 text-ink no-underline" aria-label={`${c.name}: ${c.status === "pass" ? "passed" : c.status === "fail" ? "failed" : "not started"}`}>
                  <span class:list={[
                    "block h-16 w-full max-w-7 rounded-full transition group-hover:opacity-80",
                    c.status === "pass" && "bg-ok",
                    c.status === "fail" && "bg-bad",
                    c.status === "pending" && "border-2 border-dashed border-line",
                  ]}></span>
                  <span class="w-full truncate text-center text-[11px] text-muted @2xl:text-[12px]">{checkShort[c.id]}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Lessons -->
        <div class={card}>
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-lg font-semibold">Lesson progress</h3>
              <p class="text-[15px] text-muted">{modulesDone} of {modules.length} Level 1 modules · {conceptsCovered} concepts covered</p>
            </div>
            <a class="text-[15px] font-medium text-muted hover:text-ink" href="/lessons">Lessons</a>
          </div>
          <ul class="mt-4 flex flex-col gap-2">
            {modules.map((m) => (
              <li class="grid grid-cols-[7.5rem_minmax(0,1fr)_2.25rem] items-center gap-3">
                <span class:list={["truncate text-[14px]", m.status === "next" ? "text-muted" : "text-ink", m.status === "current" && "font-semibold"]}>{m.name}</span>
                <span class:list={["grid h-2 gap-1", cols[m.total]]} role="img" aria-label={`${m.concepts} of ${m.total} concepts${m.status === "current" ? ", in progress" : ""}`}>
                  {Array.from({ length: m.total }, (_, i) => <i class:list={["rounded-full", i < m.concepts ? (m.status === "current" ? "bg-blue" : "bg-ok") : "bg-line"]}></i>)}
                </span>
                <span class="text-right text-[13px] tabular-nums text-muted">{m.concepts}/{m.total}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Level 3: History -->
    <section class="flex flex-col gap-3" aria-labelledby="history-title">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="history-title" class={level}>Recent activity</h2>
        <div class="flex flex-wrap gap-1" role="group" aria-label="Filter activity" data-filter="activity-list">
          {kinds.map((k) => (
            <button type="button" data-kind={k.id} aria-pressed={k.id === "all" ? "true" : "false"} class="min-h-8 cursor-pointer rounded-full border border-line px-3 text-[13px] font-semibold text-muted hover:text-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-on-ink">{k.label}</button>
          ))}
        </div>
      </div>
      <div class="rounded-[22px] border border-line bg-surface dark:bg-surface-2">
        <ol id="activity-list" class="flex flex-col">
          {events.map((e) => (
            <li data-kind={e.kind} class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-3 border-t border-line px-5 py-3 first:border-t-0">
              <span class:list={["mt-2 size-2 rounded-full", kindDot[e.kind]]} aria-hidden="true"></span>
              <span><span class="sr-only">{kindName[e.kind]}: </span><Explain simple={e.simple} tech={e.tech} /></span>
              <span class="text-[14px] tabular-nums text-muted">{e.time}</span>
            </li>
          ))}
        </ol>
        <p data-filter-empty hidden class="px-5 py-3 text-[15px] text-muted">Nothing here yet.</p>
      </div>
      <p class="hidden text-[14px] text-muted lg:block">The exact tool calls are in the panel below.</p>
    </section>
  </div>
</App>
