---
// Dashboard mockup (v0.1). All data below is sample data.
import Base from "../../../../packages/ui/Base.astro";
import Logo from "../../../../packages/ui/Logo.astro";
import ThemeToggle from "../../../../packages/ui/ThemeToggle.astro";

const checks: { name: string; status: "pass" | "fail" | "pending"; hint?: string; code?: string }[] = [
  { name: "No secrets in repo", status: "pass" },
  { name: "Environment config", status: "pass" },
  { name: "CI pipeline with tests", status: "pass" },
  { name: "Playwright E2E on preview deploy", status: "pass" },
  { name: "Auth on API routes", status: "fail", code: "/api/bookings" },
  { name: "Database migrations", status: "pass" },
  { name: "HTTPS and security headers", status: "pass" },
  { name: "Uptime check", status: "pending", hint: "Not set up yet" },
];
const statusTag = { pass: ["tag tag-ok", "Passed"], fail: ["tag tag-warn", "Needs attention"], pending: ["tag tag-line", "Not checked"] } as const;

const audit = [
  { time: "14:02", tool: "deploy", client: "Claude Code", result: "Waiting for approval", tag: "tag tag-warn" },
  { time: "13:48", tool: "check_readiness", client: "Claude Code", result: "6 of 8 checks passing" },
  { time: "13:40", tool: "set_secret", client: "Cursor", result: "RESEND_API_KEY set (value hidden)" },
  { time: "12:15", tool: "get_logs", client: "Claude Code", result: "3 errors, 1 explained" },
  { time: "11:57", tool: "setup_ci", client: "Claude Code", result: "Done", tag: "tag tag-ok" },
];

const connections = [
  { name: "GitHub", detail: "juan/barbershop-booking", on: true },
  { name: "Cloudflare", detail: "Workers · 1 project", on: true },
  { name: "Neon", detail: "main + 2 preview branches", on: true },
  { name: "Supabase", detail: "Optional", on: false },
];

const meter = (on: number, warn = 0) => Array.from({ length: 8 }, (_, i) => (i < on ? "bg-ink" : i < on + warn ? "bg-orange" : "bg-line"));
---
<Base title="Launchwright Dashboard" noindex>
  <div class="gutter pb-16">
    <header class="flex items-center justify-between gap-4 py-5">
      <div class="flex min-w-0 items-center gap-3">
        <Logo href="#" />
        <span class="text-2xl text-line" aria-hidden="true">/</span>
        <span class="truncate font-medium">barbershop-booking</span>
        <span class="tag max-sm:hidden">Next.js</span>
      </div>
      <div class="flex flex-none items-center gap-2.5">
        <span class="tag tag-warn max-sm:hidden">Sample data</span>
        <ThemeToggle />
        <span class="grid size-[50px] place-items-center rounded-full bg-surface-3 text-[15px] font-semibold" aria-label="Juan D." role="img">JD</span>
      </div>
    </header>

    <div class="flex flex-wrap items-end justify-between gap-4 pb-6 pt-7">
      <div>
        <p class="label">Dashboard · v0.1 mockup</p>
        <h1 class="text-[clamp(2rem,4vw,3rem)] font-bold leading-tight tracking-[-0.02em]">Good afternoon, Juan.</h1>
      </div>
      <a class="btn btn-outline" href="#">Run readiness check</a>
    </div>

    <main class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-12 [&>*]:min-w-0">
      <section class="card grid gap-3.5 sm:col-span-2 lg:col-span-4" aria-label="Readiness">
        <p class="label">Readiness</p>
        <p class="flex items-baseline gap-2 text-7xl font-bold leading-[0.9] tracking-[-0.04em]">6<small class="text-lg font-medium tracking-normal text-muted">/ 8 checks</small></p>
        <div class="grid h-2 grid-cols-8 gap-1" role="img" aria-label="6 passing, 1 failing, 1 pending">{meter(6, 1).map((c) => <i class={`rounded-full ${c}`}></i>)}</div>
        <p class="text-[15px] text-muted">2 checks left before production-ready.</p>
      </section>
      <section class="card grid gap-3.5 sm:col-span-2 lg:col-span-4" aria-label="Curriculum progress">
        <p class="label">Level 1 progress</p>
        <p class="flex items-baseline gap-2 text-7xl font-bold leading-[0.9] tracking-[-0.04em]">5<small class="text-lg font-medium tracking-normal text-muted">/ 8 modules</small></p>
        <div class="grid h-2 grid-cols-8 gap-1" role="img" aria-label="5 of 8 modules">{meter(5).map((c) => <i class={`rounded-full ${c}`}></i>)}</div>
        <p class="text-[15px] text-muted">23 concepts covered through your tool calls.</p>
      </section>
      <section class="card grid gap-3.5 sm:col-span-2 lg:col-span-4" aria-label="Production">
        <p class="label">Production</p>
        <p class="text-7xl font-bold leading-[0.9] tracking-[-0.04em]">Live</p>
        <div class="flex h-2 items-center gap-2"><span class="size-2 rounded-full bg-ok ring-4 ring-ok-bg" aria-hidden="true"></span><span class="font-medium">barbershop.juan.dev</span></div>
        <p class="text-[15px] text-muted">Deployed 2h ago · a41f9c2</p>
      </section>

      <section class="card p-0 sm:col-span-2 lg:col-span-7" aria-labelledby="checks-title">
        <div class="flex items-center justify-between gap-3 border-b border-line px-7 py-5">
          <h2 id="checks-title" class="text-xl font-semibold">Readiness checks</h2>
          <span class="label max-sm:hidden">GitHub Actions · run #48</span>
        </div>
        <ul class="divide-y divide-line">
          {checks.map((c) => (
            <li class="flex items-start justify-between gap-4 px-7 py-4">
              <span>
                {c.name}
                {c.code && <span class="mt-1 block text-[15px] text-muted"><code>{c.code}</code> has no auth check. Try <code>check_readiness --fix auth</code></span>}
                {c.hint && <span class="mt-1 block text-[15px] text-muted">{c.hint}</span>}
              </span>
              <span class={statusTag[c.status][0]}>{statusTag[c.status][1]}</span>
            </li>
          ))}
        </ul>
      </section>

      <div class="flex flex-col gap-4 sm:col-span-2 lg:col-span-5">
        <section class="card p-0" aria-labelledby="approval-title">
          <div class="flex items-center justify-between gap-3 border-b border-line px-7 py-5">
            <h2 id="approval-title" class="text-xl font-semibold">Needs approval</h2>
            <span class="tag tag-warn">1 pending</span>
          </div>
          <div class="flex flex-col gap-3 p-7">
            <p class="text-2xl font-semibold tracking-[-0.01em]">Migration drops a column</p>
            <p class="text-[15px] text-muted">Requested by <b class="text-ink">Claude Code</b> via <code>deploy</code> · 4 min ago</p>
            <pre class="term rounded-xl bg-warn-bg px-4 py-3 text-warn">- ALTER TABLE bookings DROP COLUMN phone;</pre>
            <p class="text-[15px] text-muted">Deletes phone numbers from 132 bookings. Only recoverable from a backup.</p>
            <div class="mt-1 flex gap-2.5">
              <button class="btn flex-1" type="button">Approve</button>
              <button class="btn btn-outline flex-1" type="button">Reject</button>
            </div>
          </div>
        </section>

        <section class="card flex flex-1 flex-col gap-2.5 border-transparent bg-blue text-white" aria-labelledby="lesson-title">
          <p class="text-base font-medium text-white/75">Next lesson</p>
          <p id="lesson-title" class="text-4xl font-bold leading-tight tracking-[-0.03em]">Auth on API routes</p>
          <p class="text-[15px]">Why every request to <code class="bg-white/15 text-white">/api/bookings</code> needs to prove who's calling, and how to add it without breaking your app.</p>
          <div class="mt-auto flex items-center justify-between gap-3 pt-2">
            <span class="text-[15px] text-white/75">~8 min</span>
            <a class="btn border-white bg-white text-night" href="#">Start lesson</a>
          </div>
        </section>
      </div>

      <section class="card p-0 sm:col-span-2 lg:col-span-12" aria-labelledby="audit-title">
        <div class="flex items-center justify-between gap-3 border-b border-line px-7 py-5">
          <h2 id="audit-title" class="text-xl font-semibold">Audit log</h2>
          <a class="label" href="#">View all</a>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[560px] text-left">
            <thead class="text-[15px] text-muted"><tr><th class="px-7 py-3 font-medium">Time</th><th class="px-3 py-3 font-medium">Tool</th><th class="px-3 py-3 font-medium">Client</th><th class="px-7 py-3 font-medium">Result</th></tr></thead>
            <tbody class="divide-y divide-line border-t border-line">
              {audit.map((r) => (
                <tr>
                  <td class="px-7 py-3.5 tabular-nums">{r.time}</td>
                  <td class="px-3 py-3.5 font-medium">{r.tool}</td>
                  <td class="px-3 py-3.5">{r.client}</td>
                  <td class="px-7 py-3.5">{r.tag ? <span class={r.tag}>{r.result}</span> : r.result}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {connections.map((c) => (
        <section class="card flex flex-col gap-2 lg:col-span-3" aria-label={c.name}>
          <div class="flex items-center justify-between gap-2">
            <p class="text-xl font-semibold">{c.name}</p>
            <span class={c.on ? "tag tag-ok" : "tag tag-line"}>{c.on ? "Connected" : "Not connected"}</span>
          </div>
          <p class="text-muted">{c.detail}</p>
        </section>
      ))}
    </main>
  </div>
</Base>
