---
import App from "../layouts/App.astro";
import Explain from "../components/Explain.astro";
import { audit, connections, secrets, approval } from "../data/sample";

const tabs = [
  { id: "approvals", label: "Approvals", count: "1" },
  { id: "secrets", label: "Secrets" },
  { id: "accounts", label: "Accounts" },
  { id: "audit", label: "Audit log" },
];
---
<App title="Security" page="security">
  <div class="flex flex-col gap-4">
    <div>
      <p class="label">Security</p>
      <h1 class="text-[clamp(1.5rem,2.2vw,1.875rem)] font-bold leading-tight tracking-[-0.02em]">You stay in control</h1>
    </div>

    <div class="card rounded-xl p-0">
      <div role="tablist" aria-label="Security" data-tabs class="tabs px-4 pt-4">
        {tabs.map((t, i) => (
          <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? "true" : "false"} class="tab">
            {t.label}{t.count && <span class="count">{t.count}</span>}
          </button>
        ))}
      </div>

      <div id="panel-approvals" role="tabpanel" aria-labelledby="tab-approvals" class="p-4">
        <div class="flex flex-col gap-3 rounded-xl border border-line bg-surface p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-2xl font-semibold">{approval.title}</p>
            <span class="tag tag-warn">Waiting</span>
          </div>
          <p class="text-[14px] text-muted">Asked by <b class="text-ink">{approval.client}</b> via <code>{approval.tool}</code> · {approval.ago}</p>
          <pre class="term rounded-lg bg-warn-bg px-4 py-2.5 text-warn">{approval.diff}</pre>
          <p><Explain simple={approval.simple} tech={approval.tech} /></p>
          <div class="flex flex-wrap gap-2.5">
            <button class="btn btn-sm" type="button" value="approve" data-decide="sec-decision">Approve</button>
            <button class="btn btn-sm btn-outline" type="button" value="reject" data-decide="sec-decision">Reject</button>
          </div>
          <p id="sec-decision" class="text-[14px] text-muted empty:hidden" role="status"></p>
        </div>
      </div>

      <div id="panel-secrets" role="tabpanel" aria-labelledby="tab-secrets" class="flex flex-col gap-4 p-4">
        <p class="text-muted"><Explain simple="Secrets are passwords and keys your app needs. Your AI tool can use them, but can't read them." tech="Stored encrypted; injected as Worker secrets and GitHub Actions secrets. Values never appear in tool results or logs." /></p>
        <ul class="divide-y divide-line rounded-xl border border-line bg-surface">
          {secrets.map((s) => (
            <li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2.5">
              <code class="text-[16px]">{s.name}</code>
              <span class="flex-1 text-[14px] text-muted">{s.where} · updated {s.updated}</span>
              <span class="tag tag-line">AI: use only</span>
            </li>
          ))}
        </ul>
        <p class="rounded-lg bg-warn-bg px-4 py-2.5 text-[14px] text-warn">Claude Code asked to read <code class="bg-transparent p-0">DATABASE_URL</code> at 13:41 · Blocked</p>
      </div>

      <div id="panel-accounts" role="tabpanel" aria-labelledby="tab-accounts" class="p-4">
        <ul class="grid grid-cols-1 gap-3 @2xl:grid-cols-2">
          {connections.map((c) => (
            <li class="flex flex-col gap-1.5 rounded-xl border border-line bg-surface p-4">
              <div class="flex items-center justify-between gap-2">
                <p class="text-base font-semibold">{c.name}</p>
                <span class={c.on ? "tag tag-ok" : "tag tag-line"}>{c.on ? "Connected" : "Not connected"}</span>
              </div>
              <p class="text-muted">{c.detail}</p>
              <p class="text-[14px] text-muted"><span class="font-medium text-ink">Can do:</span> {c.scope}</p>
            </li>
          ))}
        </ul>
      </div>

      <div id="panel-audit" role="tabpanel" aria-labelledby="tab-audit" class="overflow-x-auto">
        <table class="w-full min-w-[560px] text-left">
          <thead class="text-[14px] text-muted"><tr><th class="px-4 py-2 font-medium">Time</th><th class="px-3 py-2.5 font-medium">Tool</th><th class="px-3 py-2.5 font-medium">AI tool</th><th class="px-4 py-2 font-medium">Result</th></tr></thead>
          <tbody class="divide-y divide-line border-t border-line">
            {audit.map((r) => (
              <tr>
                <td class="px-4 py-2.5 tabular-nums">{r.time}</td>
                <td class="px-3 py-2.5"><code>{r.tool}</code></td>
                <td class="px-3 py-2.5">{r.client}</td>
                <td class="px-4 py-2.5">{r.tone ? <span class={`tag tag-${r.tone}`}>{r.result}</span> : r.result}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <span id="audit" class="sr-only">Audit log is in the Audit log tab.</span>
  </div>
</App>
