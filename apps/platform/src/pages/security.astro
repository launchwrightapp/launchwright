---
import App from "../layouts/App.astro";
import { GUIDES } from "../../../../packages/core/connect-guides";

const guides = [GUIDES.cloudflare, GUIDES.neon, GUIDES.supabase];

const tabs = [
  { id: "approvals", label: "Approvals", count: true },
  { id: "accounts", label: "Accounts" },
  { id: "secrets", label: "Secrets" },
  { id: "audit", label: "Audit log" },
];
const input = "min-h-10 w-full min-w-0 flex-1 rounded-lg border border-line bg-surface px-3 text-[15px] text-ink dark:bg-surface-2";
---
<App title="Security" page="security">
  <div class="flex flex-col gap-4">
    <div>
      <p class="label">Security</p>
      <h1 class="text-[clamp(1.5rem,2.2vw,1.875rem)] font-bold leading-tight tracking-[-0.02em]">You stay in control</h1>
      <p class="mt-1 text-[14px] text-muted">Your AI tool asks; you decide. Keys are stored encrypted and never shown to the AI. Everything is logged.</p>
    </div>

    <div class="card rounded-xl p-0">
      <div role="tablist" aria-label="Security" data-tabs data-hash-tabs class="tabs px-4 pt-4">
        {tabs.map((t, i) => (
          <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? "true" : "false"} class="tab">
            {t.label}{t.count && <span hidden data-if="hasApprovals" class="count" data-bind="approvalCount"></span>}
          </button>
        ))}
      </div>

      <div id="panel-approvals" role="tabpanel" aria-labelledby="tab-approvals" class="flex flex-col gap-3 p-4">
        <p data-unless="hasApprovals" class="text-muted">Nothing is waiting for you. When your AI tool wants to deploy to production, roll back, or replace a secret, the request shows up here and nothing happens until you approve it.</p>
        <ul class="flex flex-col gap-3" data-each="approvals">
          <template>
            <li class="flex flex-col gap-3 rounded-xl border border-line bg-surface p-4">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="text-xl font-semibold" data-bind="title"></p>
                <span class="tag tag-warn">Waiting</span>
              </div>
              <p class="text-[14px] text-muted">Asked by <b class="text-ink" data-bind="askedBy"></b> via <code data-bind="tool"></code> · <span data-bind="asked"></span> · <span data-bind="repo"></span></p>
              <p data-bind="summary"></p>
              <pre class="term overflow-x-auto rounded-lg bg-warn-bg px-4 py-2.5 text-warn" data-bind="detailText"></pre>
              <div class="flex flex-wrap gap-2.5">
                <button class="btn btn-sm" type="button" data-decision="approve" data-attr="data-approval:id;data-status:approveId">Approve</button>
                <button class="btn btn-sm btn-outline" type="button" data-decision="reject" data-attr="data-approval:id;data-status:approveId">Reject</button>
              </div>
              <p class="text-[14px] text-muted empty:hidden" role="status" data-attr="id:approveId"></p>
            </li>
          </template>
        </ul>
      </div>

      <div id="panel-accounts" role="tabpanel" aria-labelledby="tab-accounts" class="flex flex-col gap-4 p-4">
        <div class="flex flex-col gap-2 rounded-xl bg-blue/10 p-4 text-[14px]">
          <p class="flex flex-wrap items-baseline justify-between gap-2">
            <span class="text-base font-semibold text-ink">Bring your own cloud</span>
            <span class="text-muted"><span data-bind="connectedCount">0</span> of 3 connected · you need Cloudflare and one database</span>
          </p>
          <p class="text-muted">Your app runs on your own accounts' free plans. You create each key yourself, with only the permissions launchwright needs, and paste it here. Your AI tool can walk you through it (ask it to run the <code>lesson-connect</code> prompt), but it never sees or holds your keys. That's the point.</p>
        </div>

        {guides.map((g) => (
          <section id={`connect-${g.id}`} class="scroll-mt-28 rounded-xl border border-line bg-surface dark:bg-surface-2" aria-labelledby={`${g.id}-title`} data-class={`border-ok/50:account.${g.id}.connected`}>
            <header class="flex flex-wrap items-start justify-between gap-3 border-b border-line p-4">
              <div class="min-w-0">
                <h2 id={`${g.id}-title`} class="text-lg font-semibold">{g.name} <span class="font-normal text-muted">· {g.tagline}</span></h2>
                <p class="mt-1 text-[14px] text-muted">{g.forWhat}</p>
                <p class="mt-2 flex flex-wrap items-center gap-1.5 text-[13px] text-muted">
                  Used by {g.tools.map((t) => <code class="text-[12px]">{t}</code>)}
                </p>
              </div>
              <span class="tag tag-line flex-none" data-class={`tag-ok:account.${g.id}.connected;tag-line:account.${g.id}.notConnected`} data-bind={`account.${g.id}.stateLabel`}>Not connected</span>
            </header>

            <!-- Connected: who, what it can do, how to take it back -->
            <div hidden data-if={`account.${g.id}.connected`} class="grid grid-cols-1 gap-4 p-4 text-[14px] @3xl:grid-cols-2">
              <div class="flex flex-col gap-1.5">
                <p><span class="font-semibold">Connected:</span> <span data-bind={`account.${g.id}.label`}></span></p>
                <p class="text-muted" data-bind={`account.${g.id}.connectedAgo`}></p>
                <p class="mt-2 font-semibold">How to take access back</p>
                <p class="text-muted">{g.revoke}</p>
                <button type="button" class="btn btn-sm btn-outline mt-2 self-start" data-disconnect={g.id} data-status={`${g.id}-status`}>Disconnect</button>
              </div>
              <div>
                <p class="font-semibold">Limits</p>
                <ul class="mt-1 flex list-disc flex-col gap-1 pl-5 text-muted">{g.limits.map((l) => <li>{l}</li>)}</ul>
              </div>
            </div>

            <!-- How to connect: open until connected; stays available to replace the key -->
            <details class="group" data-attr={`open:account.${g.id}.notConnected`}>
              <summary class="flex cursor-pointer items-center gap-2 px-4 py-3 text-[14px] font-semibold">
                <svg class="size-4 transition group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                <span data-unless={`account.${g.id}.connected`}>How to connect {g.name}</span><span hidden data-if={`account.${g.id}.connected`}>Replace the {g.method === "token" ? "key" : "connection"}</span>
                <span class="ml-auto font-normal text-muted">about {g.minutes} min · {g.free.split(":")[0]}</span>
              </summary>
              <div class="grid grid-cols-1 gap-5 border-t border-line p-4 @4xl:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
                <ol class="flex flex-col gap-3">
                  {g.steps.map((s, i) => (
                    <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-3">
                      <span class="grid size-8 place-items-center rounded-full bg-ink text-[13px] font-semibold text-on-ink">{i + 1}</span>
                      <div class="pt-1">
                        <p class="font-semibold">{s.title}</p>
                        <p class="text-[14px] text-muted">{s.detail}</p>
                        {i === 0 && g.method === "token" && (
                          <a class="btn btn-sm mt-2" href={g.action.href} target="_blank" rel="noopener">{g.action.label} ↗</a>
                        )}
                        {i === 0 && g.method === "oauth" && (
                          <>
                            <a hidden data-if="supabaseAvailable" class="btn btn-sm mt-2" href={g.action.href}>{g.action.label}</a>
                            <p data-unless="supabaseAvailable" class="mt-2 rounded-lg bg-surface-3 px-3 py-2 text-[13px]">Supabase sign-in isn't switched on for this server yet. Use Neon for now.</p>
                          </>
                        )}
                      </div>
                    </li>
                  ))}
                  {g.method === "token" && (
                    <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-3">
                      <span class="grid size-8 place-items-center rounded-full border border-line text-muted" aria-hidden="true">↳</span>
                      <form data-connect={g.id} data-status={`${g.id}-status`} class="flex flex-col gap-2">
                        <label for={`${g.id}-token`} class="font-semibold">{g.id === "cloudflare" ? "Cloudflare API token" : "Neon API key"}</label>
                        <div class="flex flex-wrap gap-2">
                          <input id={`${g.id}-token`} name="secret" type="password" autocomplete="off" spellcheck="false" required maxlength="500" placeholder="Paste it here, not in your AI chat" class={input} />
                          <button type="submit" class="btn btn-sm">Connect</button>
                        </div>
                      </form>
                    </li>
                  )}
                  <li><p id={`${g.id}-status`} role="status" class="text-[14px] empty:hidden"></p></li>
                </ol>

                <div class="flex flex-col gap-4 text-[14px]">
                  <div>
                    <p class="font-semibold">What launchwright gets, and why</p>
                    <table class="mt-2 w-full text-left">
                      <tbody class="divide-y divide-line border-y border-line">
                        {g.permissions.map((p) => (
                          <tr><td class="py-2 pr-3 align-top font-medium">{p.name}</td><td class="py-2 text-muted">{p.why}</td></tr>
                        ))}
                      </tbody>
                    </table>
                    {g.permissionsNote && <p class="mt-2 text-muted">{g.permissionsNote}</p>}
                  </div>
                  <div class="rounded-lg bg-warn-bg p-3 text-warn">
                    <p class="font-semibold">Watch out</p>
                    <ul class="mt-1 flex list-disc flex-col gap-1 pl-5">{g.pitfalls.map((p) => <li>{p}</li>)}</ul>
                  </div>
                  <p class="text-muted">{g.free}</p>
                </div>
              </div>
            </details>
          </section>
        ))}
      </div>

      <div id="panel-secrets" role="tabpanel" aria-labelledby="tab-secrets" class="flex flex-col gap-4 p-4">
        <p class="text-muted">Secrets are passwords and keys your app needs. Your AI tool asks for them by name; you type the value on a launchwright page, and it goes straight to GitHub or Cloudflare. Only names are listed here, never values.</p>
        <ul hidden data-if="hasSecrets" class="divide-y divide-line rounded-xl border border-line bg-surface" data-each="secrets">
          <template>
            <li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2.5">
              <code class="text-[16px]" data-bind="name"></code>
              <span class="flex-1 text-[14px] text-muted"><span data-bind="where"></span> · <span data-bind="repo"></span> · updated <span data-bind="updated"></span></span>
              <span class="tag tag-line">AI: name only</span>
            </li>
          </template>
        </ul>
        <p data-unless="hasSecrets" class="text-[14px] text-muted">No secrets set through launchwright yet. Ask your AI tool: "Use launchwright set_secret for RESEND_API_KEY on owner/repo".</p>
      </div>

      <div id="panel-audit" role="tabpanel" aria-labelledby="tab-audit" class="overflow-x-auto">
        <table class="w-full min-w-[640px] text-left">
          <thead class="text-[14px] text-muted"><tr><th class="px-4 py-2 font-medium">When</th><th class="px-3 py-2.5 font-medium">Who</th><th class="px-3 py-2.5 font-medium">Action</th><th class="px-4 py-2 font-medium">Result</th></tr></thead>
          <tbody class="divide-y divide-line border-t border-line" data-each="audit">
            <template>
              <tr>
                <td class="whitespace-nowrap px-4 py-2.5 tabular-nums" data-bind="ago"></td>
                <td class="px-3 py-2.5" data-bind="who"></td>
                <td class="px-3 py-2.5"><code data-bind="tool"></code></td>
                <td class="px-4 py-2.5"><span class="" data-class="tag:isFlagged;tag-warn:isPending;tag-bad:isProblem" data-bind="summary"></span></td>
              </tr>
            </template>
          </tbody>
        </table>
        <p data-unless="hasAudit" class="px-4 py-3 text-[14px] text-muted">The audit log is empty. It records every tool call and every decision you make here.</p>
      </div>
    </div>
    <span id="audit" class="sr-only">Audit log is in the Audit log tab.</span>
  </div>
</App>
