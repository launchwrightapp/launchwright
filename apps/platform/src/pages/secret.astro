---
import App from "../layouts/App.astro";

// /secret?id=... : the learner's AI tool asked for a secret by name (set_secret or
// connect_database). The learner types the value here; it's sealed and handed to the MCP server,
// which writes it to GitHub or Cloudflare and deletes it. The AI never sees it.
const input = "min-h-11 w-full rounded-lg border border-line bg-surface px-3 font-mono text-[15px] text-ink dark:bg-surface-2";
---
<App title="Add a secret" page="security">
  <div class="mx-auto flex w-full max-w-xl flex-col gap-4" data-secret-root>
    <div>
      <p class="label">Secret</p>
      <h1 class="text-[clamp(1.5rem,2.2vw,1.875rem)] font-bold leading-tight tracking-[-0.02em]">Add <code class="text-[0.9em]" data-bind="secret.name">a secret</code></h1>
      <p class="mt-1 text-muted">Your AI tool asked for this value by name. It goes from this page straight to <span data-bind="secret.where">GitHub or Cloudflare</span> for <span data-bind="secret.repo">your repo</span>. The AI never sees it, and nobody can read it back.</p>
    </div>

    <form data-secret-form data-secret-state="form" hidden class="card flex flex-col gap-3 rounded-xl p-4">
      <label for="secret-value" class="font-semibold">Value</label>
      <input id="secret-value" name="value" type="password" autocomplete="off" spellcheck="false" maxlength="8192" class={input} placeholder="Paste the value here" />
      <label class="flex items-center gap-2 text-[14px] text-muted"><input id="secret-reveal" type="checkbox" /> Show what I typed</label>
      <p class="text-[14px] text-muted">Where do I get it? From the service the key belongs to (its dashboard's API keys page). Never paste it into your AI chat.</p>
      <div class="flex flex-wrap gap-2">
        <button type="submit" class="btn btn-sm" value="save">Save secret</button>
        <button type="submit" class="btn btn-sm btn-outline" value="cancel" formnovalidate>Cancel request</button>
      </div>
      <p id="secret-status" role="status" class="text-[14px] text-warn empty:hidden"></p>
    </form>

    <div data-secret-state="done" hidden class="rounded-xl bg-ok-bg p-4 text-ok" role="status">
      <p class="font-semibold">Saved.</p>
      <p>Go back to your AI tool and tell it you're done. It will finish putting the secret in place.</p>
    </div>
    <div data-secret-state="cancelled" hidden class="rounded-xl bg-surface-3 p-4" role="status">Request cancelled. Nothing was saved.</div>
    <div data-secret-state="expired" hidden class="rounded-xl bg-warn-bg p-4 text-warn" role="status">This link expired (they last an hour). Ask your AI tool to run set_secret again for a new one.</div>
    <div data-secret-state="invalid" hidden class="rounded-xl bg-warn-bg p-4 text-warn" role="alert"><p id="secret-invalid">This link isn't valid.</p></div>
  </div>
</App>
