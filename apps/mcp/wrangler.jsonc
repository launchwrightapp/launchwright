{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "launchwright-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: the MCP SDK and the OAuth library use a few Node APIs.
  // global_fetch_strictly_public: needed to fetch Client ID Metadata Documents safely.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "mcp.launchwright.app", "custom_domain": true }],
  "observability": { "enabled": true },
  // PLATFORM_ORIGIN: where approval and secret links send the learner.
  "vars": { "GITHUB_CLIENT_ID": "Iv23lixXjMCTRCvuULLf", "PLATFORM_ORIGIN": "https://platform.launchwright.app" },
  // OAuth grants, clients and tokens (stored hashed; props encrypted). Create it once with
  // `npx wrangler kv namespace create OAUTH_KV` and put the id here (ids aren't secret).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "b3875cf5c6bc4106b632c50daa69622a" }]
  // Secrets (not in this file): GITHUB_CLIENT_SECRET (same GitHub App as the platform),
  // DATABASE_URL (lessons, projects, audit log, approvals), TOKEN_KEY (same as the platform's:
  // opens the sealed account tokens), and optionally SUPABASE_CLIENT_ID / SUPABASE_CLIENT_SECRET.
  // CI deploys them from the platform repo secrets.
  // Locally: .dev.vars (see .dev.vars.example).
}
