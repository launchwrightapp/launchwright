{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "launchwright-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: the MCP SDK and the OAuth library use a few Node APIs.
  // global_fetch_strictly_public: needed to fetch Client ID Metadata Documents safely.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "mcp.launchwright.app", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": { "GITHUB_CLIENT_ID": "Iv23lixXjMCTRCvuULLf" },
  // OAuth grants, clients and tokens (stored hashed; props encrypted). Create it once with
  // `npx wrangler kv namespace create OAUTH_KV` and put the id here (ids aren't secret).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_OAUTH_KV_ID" }]
  // Secrets (not in this file): GITHUB_CLIENT_SECRET (same GitHub App as the platform) and,
  // optionally, DATABASE_URL for lesson progress. Set with `npx wrangler secret put <NAME>`.
  // Locally: .dev.vars (see .dev.vars.example).
}
