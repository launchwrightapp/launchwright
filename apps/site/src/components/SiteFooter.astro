---
// Mega footer: closing call to action, link columns, and a full-width wordmark.
// Always dark, in both themes.
interface Props { home?: boolean }
const { home = false } = Astro.props;
const base = home ? "" : "/";
const pilotHref = home ? "#pilot" : "/pilot";

const columns: [string, [string, string][]][] = [
  ["Product", [
    [`${base}#how`, "How it works"],
    [`${base}#readiness`, "Readiness checks"],
    [`${base}#trust`, "Security"],
    [`${base}#curriculum`, "Level 2: your own VPS"],
  ]],
  ["Learn", [
    [`${base}#curriculum`, "Git"],
    [`${base}#curriculum`, "Env & secrets"],
    [`${base}#curriculum`, "Database"],
    [`${base}#curriculum`, "CI/CD and testing"],
    [`${base}#curriculum`, "Deploy and monitoring"],
  ]],
  ["Pilot", [
    [pilotHref, "Join the free pilot"],
    [`${base}#faq`, "FAQ"],
    ["https://www.npmjs.com/package/launchwright", "npm package"],
  ]],
  ["Legal", [
    ["/privacy", "Privacy policy"],
    ["/terms", "Terms of use"],
  ]],
];
---
<footer class="gutter overflow-hidden bg-night text-white">
  <!-- Closing call to action -->
  <div class="flex flex-col items-start justify-between gap-8 border-b border-white/10 py-12 md:flex-row md:items-end md:py-16">
    <h2 class="max-w-[16ch] text-title font-bold text-balance">Ready to ship your first real app?</h2>
    <div class="flex flex-col items-start gap-3 md:items-end">
      <a class="btn border-white bg-white text-night" href={pilotHref}>Join the free pilot</a>
      <p class="text-[15px] text-white/55">10 seats. Free for the pilot cohort.</p>
    </div>
  </div>

  <!-- Link columns -->
  <div class="grid gap-8 py-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr_1fr]">
    <div class="flex flex-col gap-4 sm:col-span-2 lg:col-span-1">
      <p class="max-w-[24rem] text-[19px] leading-relaxed text-white/70">Learn how real production apps work while you ship your own, with the AI tool you already use.</p>
      <p class="text-[15px] text-white/45">Built in the Philippines for Filipino students, beginners, and career shifters.</p>
    </div>
    {columns.map(([title, links]) => (
      <nav aria-label={title} class="flex flex-col gap-3">
        <p class="font-semibold">{title}</p>
        {links.map(([href, label]) => <a class="text-white/60 no-underline transition hover:text-white" href={href}>{label}</a>)}
      </nav>
    ))}
  </div>

  <!-- Wordmark -->
  <p class="logo pointer-events-none block select-none whitespace-nowrap pb-[0.22em] pt-2 text-center text-[clamp(3rem,14.6vw,17rem)] leading-[0.9] tracking-[-0.025em] text-white" aria-hidden="true">launchwright</p>

  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-white/10 py-6 text-[15px] text-white/50">
    <span>© 2026 Launchwright</span>
    <span>RA 10173 · We only collect what the pilot needs.</span>
  </div>
</footer>
