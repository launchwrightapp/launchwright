---
import Logo from "../../../../packages/ui/Logo.astro";
import ThemeToggle from "../../../../packages/ui/ThemeToggle.astro";

// On the home page links are "#section"; on other pages they go back to "/#section".
interface Props { home?: boolean }
const { home = false } = Astro.props;
const base = home ? "" : "/";
const pilotHref = home ? "#pilot" : "/pilot";

const nav = [
  ["#how", "How it works"],
  ["#curriculum", "Learning path"],
  ["#readiness", "Readiness"],
  ["#trust", "Security"],
  ["#faq", "FAQ"],
];
---
<!-- Scrolling down shrinks the bar into a centered floating pill; scrolling up restores it (site.ts). -->
<header data-autohide class="group/header gutter sticky top-0 z-20 h-[84px] bg-surface/90 backdrop-blur transition-[background-color,translate] duration-500 supports-[backdrop-filter]:bg-surface/75 motion-reduce:transition-none data-[hidden]:-translate-y-full data-[compact]:bg-transparent data-[compact]:backdrop-blur-none supports-[backdrop-filter]:data-[compact]:bg-transparent">
  <div class="mx-auto flex h-[84px] max-w-full items-center justify-between gap-4 rounded-none ring-line transition-all duration-500 ease-[cubic-bezier(0.2,0.7,0.2,1)] motion-reduce:transition-none group-data-[compact]/header:translate-y-5 group-data-[compact]/header:h-[60px] group-data-[compact]/header:max-w-[1080px] group-data-[compact]/header:rounded-2xl group-data-[compact]/header:bg-surface/90 group-data-[compact]/header:pl-5 group-data-[compact]/header:pr-2 group-data-[compact]/header:shadow-[0_16px_40px_-20px_rgb(0_0_0/0.35)] group-data-[compact]/header:ring-1 group-data-[compact]/header:backdrop-blur-md">
    <Logo />
    <nav aria-label="Sections" class="hidden gap-1 text-[17px] font-medium transition-all lg:flex group-data-[compact]/header:text-[15px]" data-scrollspy={home ? "" : undefined}>
      {nav.map(([href, label]) => <a href={base + href} class="rounded-lg px-4 py-2 text-muted no-underline transition hover:text-ink aria-[current=true]:bg-blue aria-[current=true]:text-white">{label}</a>)}
    </nav>
    <div class="flex items-center gap-2.5">
      <ThemeToggle />
      <a class="btn btn-cta hidden transition-all sm:inline-flex group-data-[compact]/header:min-h-11 group-data-[compact]/header:px-4 group-data-[compact]/header:text-[15px]" href={pilotHref}>Join the free pilot</a>

      <!-- Mobile menu: custom popover (packages/ui/dropdown.ts) -->
      <div class="relative lg:hidden" data-popover>
        <button type="button" data-popover-trigger aria-expanded="false" aria-controls="site-menu" aria-label="Menu" class="group grid size-[50px] cursor-pointer place-items-center rounded-full border border-line bg-surface text-ink">
          <svg class="size-5 group-aria-expanded:hidden" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h14M3 14h14" /></svg>
          <svg class="hidden size-5 group-aria-expanded:block" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
        </button>
        <nav id="site-menu" data-popover-panel hidden aria-label="Menu" class="absolute right-0 top-[calc(100%+12px)] flex w-[min(20rem,calc(100vw-2rem))] flex-col gap-1 rounded-2xl border border-line bg-surface p-3 shadow-2xl shadow-black/10">
          {nav.map(([href, label]) => <a href={base + href} class="rounded-2xl px-4 py-3 text-[18px] font-medium text-ink no-underline hover:bg-surface-2">{label}</a>)}
          <a class="btn btn-cta mt-2" href={pilotHref}>Join the free pilot</a>
        </nav>
      </div>
    </div>
  </div>
</header>
