---
// Pilot, part 1 of 3: the email. Sends a 6-digit code (worker/verify.ts), then /pilot/verify.
// The worker fills data-sitekey for the Turnstile check (scripts/pilot-start.ts).
import Pilot from "../layouts/Pilot.astro";
const how = [
  ["Confirm your email", "We send a 6-digit code. It takes a minute."],
  ["Answer 5 short steps", "About you, your experience, your project, your goals. About 3 minutes."],
  ["We read it ourselves", "If you're in, we email you a link to get started."],
];
---
<Pilot
  title="Apply for the pilot · Launchwright"
  description="Confirm your email, then answer five short steps. About 4 minutes."
  url="https://launchwright.app/pilot"
  part={1}
  heading="Apply for the pilot"
  intro="First, confirm your email. Then tell us about you and what you want to ship. It helps us pick a cohort we can really help."
>
  <ol slot="side" class="grid gap-4 text-[17px]" aria-label="How applying works">
    {how.map(([t, d], i) => (
      <li class="flex gap-3.5">
        <span class="grid size-8 flex-none place-items-center rounded-full border border-line text-[15px] font-semibold tabular-nums">{i + 1}</span>
        <span><b class="block font-semibold">{t}</b><span class="text-muted">{d}</span></span>
      </li>
    ))}
  </ol>

  <form id="pilot-start" class="flex flex-col gap-6 p-6 md:p-10" action="/api/pilot/code" method="post" novalidate>
    <div class="flex flex-col gap-2">
      <h2 class="text-[1.75rem] font-bold leading-tight tracking-[-0.015em]">What's your email?</h2>
      <p class="text-muted">We'll send a code to confirm it's yours. We only use it for the pilot.</p>
    </div>
    <p data-expired hidden class="rounded-2xl bg-warn-bg px-4 py-3 font-medium text-warn">Your email check expired. Please confirm your email again. Your answers are still saved in this browser.</p>
    <label class="block">
      <span class="mb-2 block font-medium">Email</span>
      <input class="input" type="email" name="email" required maxlength="254" autocomplete="email" inputmode="email" placeholder="juan@example.com" />
    </label>
    <div class="absolute -left-[9999px] size-px overflow-hidden" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <!-- Turnstile bot check. Stays invisible unless Cloudflare needs a click. -->
    <div data-turnstile data-sitekey="" class="empty:hidden"></div>
    <div class="flex flex-wrap items-center gap-4">
      <button class="btn" type="submit" data-submit>Send code</button>
      <p id="pilot-status" class="m-0 font-medium data-[kind=err]:text-warn" role="status" aria-live="polite"></p>
    </div>
    <p class="text-[15px] text-muted">By continuing you agree to get one email with your code. See the <a class="font-medium text-ink underline underline-offset-4" href="/privacy">privacy policy</a>.</p>
    <noscript><p class="text-muted">The bot check needs JavaScript. You can also apply by email: <a class="font-medium text-ink underline underline-offset-4" href="mailto:hello@launchwright.app">hello@launchwright.app</a>.</p></noscript>
  </form>
</Pilot>

<script>
  import "../scripts/pilot-start.ts";
</script>
