            <div class="flex items-center justify-between gap-3 border-b border-line px-7 py-5 md:px-10">
              <p class="text-[19px] font-semibold">Your application</p>
              <p class="whitespace-nowrap text-[15px] text-muted max-sm:hidden">About 4 minutes</p>
            </div>
            <form id="waitlist" class="flex flex-col gap-6 p-7 md:p-10" action="/api/pilot/code" method="post" novalidate>
              <p class="text-[19px] leading-relaxed text-muted">A few short questions about you and what you want to ship. We use it to pick people we can actually help.</p>
              <label class="block">
                <span class="mb-2 block font-medium">Email</span>
                <input class="input" type="email" name="email" required maxlength="254" autocomplete="email" placeholder="juan@example.com" />
              </label>
              <div class="absolute -left-[9999px] size-px overflow-hidden" aria-hidden="true">
                <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
              </div>
              <!-- Turnstile bot check (scripts/code-form.ts). The worker fills data-sitekey. -->
              <div data-turnstile data-sitekey="" class="empty:hidden"></div>
              <div class="flex flex-wrap items-center gap-4">
                <button class="btn btn-cta" type="submit">Send code</button>
                <p id="waitlist-status" class="m-0 font-medium data-[kind=err]:text-warn" role="status" aria-live="polite"></p>
