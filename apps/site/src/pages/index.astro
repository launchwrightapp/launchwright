              <p class="text-[15px] text-muted">We email you a 6-digit code to confirm it's you. Then 5 short steps, about 3 minutes. See the <a class="font-medium text-ink underline underline-offset-4" href="/privacy">privacy policy</a>.</p>
            </form>
          </div>
        </div>

        <!-- What happens next -->
        <ol class="grid divide-line border-t border-line sm:grid-cols-3 sm:divide-x max-sm:divide-y" aria-label="What happens next">
          {[
            ["Apply", "Five short questions about you and your project."],
            ["We review", "We read every application and email you."],
            ["Start building", "Connect your AI tool and ship a preview."],
          ].map(([t, d], i) => (
            <li class="flex gap-3 p-6 md:px-10">
