---
import Base from "../../../../packages/ui/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Check from "../../../../packages/ui/Check.astro";
import Mark from "../../../../packages/ui/Mark.astro";
import TermLines, { type Line } from "../components/TermLines.astro";
import SectionIntro from "../components/SectionIntro.astro";

const CTA = "Join the free pilot";

// Hero arc: tiles sit on the curve y = quadratic(0,120 → 500,-20 → 1000,120) in a 1000×200 box.
// Platform activity bar icons (same as apps/platform App.astro): overview, lessons, readiness, security, connect.
const mockNav = [
  "M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z",
  "M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM4 21V5M8 7h7",
  "M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9",
  "M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z",
  "M9 7V3M15 7V3M7 7h10v4a5 5 0 0 1-10 0zM12 16v5",
];
const heroPath = [
  { pos: "left-[10%] top-[47%]", d: ["m18 16 4-4-4-4", "m6 8-4 4 4 4", "m14.5 4-5 16"] },
  { pos: "left-[30%] top-[31%]", fill: true, d: ["M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-1.96c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"] },
  { pos: "left-1/2 top-[25%]", main: true, d: ["M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z", "m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z", "M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0", "M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"] },
  { pos: "left-[70%] top-[31%]", d: ["M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z", "m9 12 2 2 4-4"] },
  { pos: "left-[90%] top-[47%]", d: ["M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"] },
];


// Dashboard preview cards. Sample numbers only.
const progressCards: { label: string; value: string; of?: string; note: string; icon: string[]; hot?: boolean }[] = [
  { label: "Readiness checks", value: "8", of: "/8", note: "All passed on your last preview deploy.", icon: ["M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z", "m9 12 2 2 4-4"] },
  { label: "Skills learned", value: "5", of: "/8", note: "Level 1. Next up: Deploy.", icon: ["M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM4 21V5M8 7h7"] },
  { label: "Lessons done", value: "12", note: "Now on: Preview deploys.", icon: ["M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"], hot: true },
  { label: "Tool calls", value: "47", note: "Each one came with a short lesson.", icon: ["m4 17 6-6-6-6", "M12 19h8"] },
];

// The core loop, shown as a walkthrough. Sample output only.
const loop: { id: string; step: string; file: string; lang: string; code: string[]; title: string; body: string; tools: string[]; term: Line[] }[] = [
  {
    id: "build",
    file: "src/lib/email.ts",
    lang: "ts",
    code: ["import { Resend } from \"resend\";", "", "// The key comes from the environment,", "// never from the code itself.", "export function mailer(env: Env) {", "  return new Resend(env.RESEND_API_KEY);", "}"],
    step: "Build",
    title: "Keep using your AI tool.",
    body: "Claude Code, Codex, or Cursor connect to Launchwright on your own subscription. Ask for what you want, and your tool calls Launchwright to set it up the way real teams do.",
    tools: ["setup_ci", "set_secret", "connect_database"],
    term: [
      { you: "Add email sign-ups with Resend." },
      { gap: true },
      { cmd: "set_secret RESEND_API_KEY" },
      { ok: "Saved to Cloudflare as a secret" },
      { ok: "Value hidden from the AI" },
      { gap: true },
      { lesson: "Secrets" },
      { text: "API keys live in your cloud's secret store," },
      { text: "never in your code or your Git history." },
    ],
  },
  {
    id: "verify",
    file: ".github/workflows/ci.yml",
    lang: "yml",
    code: ["on: pull_request", "", "jobs:", "  test:", "    runs-on: ubuntu-latest", "    steps:", "      - uses: actions/checkout@v4", "      - run: npm ci && npm test", "      # Smoke test the preview deploy", "      - run: npx playwright test"],
    step: "Verify",
    title: "Every change is checked before it's live.",
    body: "Each pull request runs your tests in GitHub Actions, deploys a preview, and runs a Playwright smoke test against it. Production only changes when everything is green.",
    tools: ["setup_ci", "deploy --preview"],
    term: [
      { cmd: "deploy --preview" },
      { ok: "Tests passed (24)" },
      { ok: "Preview deployed" },
      { ok: "Smoke test passed on the preview" },
      { gap: true },
      { text: "pr-12.my-first-app.workers.dev" },
    ],
  },
  {
    id: "learn",
    file: "lessons/preview-deploys.md",
    lang: "md",
    code: ["# Preview deploys", "", "A preview is a private copy of your app,", "built from your branch.", "", "You test here first, so a mistake never", "reaches your real users."],
    step: "Learn",
    title: "Every step comes with a short lesson.",
    body: "Each tool call returns the result and a lesson: what happened, and why. You get the full explanation the first time and one line after that. Your progress comes from the work you actually do.",
    tools: ["every tool call"],
    term: [
      { lesson: "Preview deploys · first time" },
      { text: "A preview is a private copy of your app," },
      { text: "built from this branch. You test here, so a" },
      { text: "mistake never reaches your real users." },
      { gap: true },
      { lesson: "Preview deploys · fifth time" },
      { text: "Preview passed. Safe to merge." },
    ],
  },
  {
    id: "launch",
    file: "migrations/0007_drop_phone.sql",
    lang: "sql",
    code: ["-- Destructive: this deletes data.", "-- Production deploys wait for your approval.", "", "ALTER TABLE bookings DROP COLUMN phone;"],
    step: "Launch",
    title: "Launch when the checks say you're ready.",
    body: "Readiness checks run on your own repo. Production deploys wait for your approval in the dashboard, so nothing goes live by accident.",
    tools: ["check_readiness", "deploy"],
    term: [
      { cmd: "deploy --production" },
      { warn: "Production deploy needs your approval" },
      { wait: "Waiting for your approval in the dashboard" },
      { ok: "Approved by you" },
      { ok: "Live at my-first-app.com" },
    ],
  },
];

// Tiny syntax highlighter for the sample files (escapes first, then colors).
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const COMMENT: Record<string, string> = { ts: "//", yml: "#", sql: "--" };
function highlight(line: string, lang: string) {
  const c = COMMENT[lang];
  if (c && line.trim().startsWith(c)) return `<span class="text-white/55">${esc(line)}</span>`;
  if (lang === "md" && line.startsWith("#")) return `<span class="font-semibold text-white">${esc(line)}</span>`;
  let h = esc(line).replace(/(&quot;|")(.*?)\1/g, '<span class="text-lime/85">"$2"</span>');
  if (lang === "yml") h = h.replace(/^(\s*-?\s*)([\w-]+):/, '$1<span class="text-sky-300">$2</span>:');
  if (lang === "ts") h = h.replace(/\b(import|from|export|function|return|new)\b/g, '<span class="text-orange/90">$1</span>');
  if (lang === "sql") h = h.replace(/\b(ALTER|TABLE|DROP|COLUMN)\b/g, '<span class="text-orange/90">$1</span>');
  return h;
}
const icon: Record<string, string> = { ts: "TS", yml: "YML", md: "MD", sql: "SQL" };

// The line in each step that matters, highlighted in the editor.
const focus: Record<string, number[]> = { build: [6], verify: [8, 10], learn: [6, 7], launch: [4] };

const stages = [
  {
    n: "01",
    name: "Foundation",
    blurb: "Set up your project the way teams do.",
    modules: [
      ["Git", "Branches, commits, and pull requests without the fear."],
      ["Env & secrets", "Why API keys never belong in your code."],
      ["Database", "Neon or Supabase, migrations, and backups."],
    ],
  },
  {
    n: "02",
    name: "Ship safely",
    blurb: "Catch problems before your users do.",
    modules: [
      ["CI/CD", "GitHub Actions that test before you deploy."],
      ["Testing", "Unit tests and Playwright smoke tests."],
      ["Deploy", "Preview deploys, production, and rollback."],
    ],
  },
  {
    n: "03",
    name: "Operate",
    blurb: "Keep it running and keep it safe.",
    modules: [
      ["Monitoring", "Logs, errors, and uptime checks."],
      ["Security", "Auth, security headers, and the Data Privacy Act (RA 10173)."],
    ],
  },
];

// Every readiness check: status (sample project), why it matters, how to fix it.
const checks: { name: string; pass: boolean; why: string; fix: string; affected?: string }[] = [
  { name: "No secrets in repo", pass: true, why: "A key committed to Git stays in its history, even after you delete the file.", fix: "Every commit is scanned. Move keys into your cloud's secret store with set_secret." },
  { name: "Environment config", pass: true, why: "A missing variable can crash production while everything works on your laptop.", fix: "check_env compares what your code reads with what each environment has." },
  { name: "CI pipeline with tests", pass: true, why: "Tests that only run on your laptop don't protect your main branch.", fix: "setup_ci adds a GitHub Actions workflow that runs on every pull request." },
  { name: "Playwright E2E on preview deploy", pass: true, why: "A green build can still show a blank page.", fix: "A smoke test runs against a real preview URL before you merge." },
  { name: "Auth on API routes", pass: false, why: "/api/bookings answers anyone who asks, including people who aren't logged in. Anyone could read your customers' bookings.", affected: "src/app/api/bookings/route.ts", fix: "Ask your AI tool to run check_readiness --fix auth. Review the change in the pull request before you merge." },
  { name: "Database migrations", pass: true, why: "Schema changes made by hand can't be repeated or rolled back.", fix: "Migrations live in your repo and run in CI, in order." },
  { name: "HTTPS and security headers", pass: true, why: "Headers like Content-Security-Policy block whole classes of attacks at no cost.", fix: "Your live URL's response headers are checked on every deploy." },
  { name: "Uptime check", pass: true, why: "You should hear about an outage before your users do.", fix: "Your production URL is checked regularly and you're alerted when it's down." },
];
const passing = checks.filter((c) => c.pass).length;
const fail = checks.find((c) => !c.pass);

// Security and ownership: each promise is shown as the thing you'd actually see.
const accounts = [
  ["GitHub", "github.com/juan/my-first-app", "Repo contents, Actions"],
  ["Cloudflare", "my-first-app.workers.dev", "Workers, DNS"],
  ["Neon", "my-first-app / main", "One project only"],
];

const secTabs: [string, string, string][] = [
  ["accounts", "Accounts", ""],
  ["secrets", "Secrets", ""],
  ["approvals", "Approvals", "1"],
  ["audit", "Audit log", ""],
];

const audit = [
  ["10:42", "check_env", "read 6 variables", "ok"],
  ["10:43", "set_secret", "RESEND_API_KEY, value hidden", "ok"],
  ["10:45", "deploy", "preview #48", "ok"],
  ["10:47", "deploy", "production deploy of main", "wait"],
];

const faq = [
  ["How does the pilot work?", "Apply with your email. The pilot has 10 seats, and we review every application. If you're in, we'll email you a link to get started."],
  ["Do I need to pay for an AI tool?", "You use the AI tool you already have (Claude Code, Codex, Cursor, and others) on your own subscription. It connects to Launchwright."],
  ["Where is my app hosted?", "On your own accounts: GitHub for code, Cloudflare for hosting, and Neon or Supabase for the database. We never host your app, so it stays yours."],
  ["Are my credentials safe?", "Tokens are encrypted and access is least-privilege. The AI never sees your raw credentials, and production deploys need your approval in the dashboard."],
  ["Does passing all 8 checks mean my app is secure?", "No check can promise that. The 8 checks are a solid baseline that catches common mistakes, like leaked secrets or open API routes. They can't prove your app has no bugs."],
  ["Can I ship a mobile app?", "Not yet. Launchwright is for websites and web apps that run in the browser. Native iOS and Android apps aren't supported."],
  ["Which frameworks are supported?", "At launch: Next.js, Vite (React or Vue), Astro, and Hono. PHP/Laravel, Python, and Docker come with Level 2."],
  ["I'm a beginner. Can I do this?", "Yes. Launchwright is built for students, beginners, career shifters, and people coming from vibe coding. The first time you meet a concept, you get the full explanation."],
];
---
<Base
  title="Launchwright"
  description="You built a web app with AI. Now learn to ship it. Deploy to your own cloud and learn Git, databases, testing, and security along the way."
  url="https://launchwright.app"
>
  <SiteHeader home />

  <main>
    <!-- Hero: text centered in the space above; the launch path sits on the dome at the bottom. -->
    <section aria-labelledby="hero-title" class="gutter relative isolate flex min-h-[calc(100svh-84px)] overflow-hidden flex-col items-center justify-center gap-[clamp(10px,2.2vh,28px)] py-[clamp(8px,2.5vh,64px)] text-center">
      <!-- Soft dome behind the launch path (decorative) -->
      <svg class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[clamp(120px,22vh,240px)] w-full" viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="hero-dome" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#2a17ff" stop-opacity="0.07" />
            <stop offset="1" stop-color="#2a17ff" stop-opacity="0.02" />
          </linearGradient>
        </defs>
        <path d="M120 200 Q500 -10 880 200 Z" fill="url(#hero-dome)" class="dark:opacity-[2.2]" />
      </svg>
      <h1 id="hero-title" class="mt-auto text-display font-bold text-balance">You built it with AI. <span class="block">Now learn to ship it.</span></h1>
      <p class="max-w-[36rem] text-[clamp(18px,2.9vh,22px)] leading-snug text-muted text-balance">For websites and web apps. From your first commit to a deployed app that passes the checks real teams run.</p>
      <div class="flex items-center gap-2.5 text-muted max-sm:order-1 sm:[@media(max-height:780px)]:hidden">
        <span class="flex gap-1" aria-hidden="true">{Array.from({ length: 10 }, () => <i class="size-2.5 rounded-full bg-ink opacity-20"></i>)}</span>
        <span>Free pilot for <b class="font-semibold text-ink">10 learners</b></span>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-6" data-hero-cta>
        <a class="btn btn-cta" href="#pilot">{CTA}</a>
        <a class="text-[17px] font-semibold underline-offset-4 hover:underline" href="#how">See how it works</a>
      </div>
      <!-- The path to launch: your code, GitHub, launch, secured, in the cloud. Decorative.
           The tiles float gently (theme.css .float); still for reduced motion. -->
      <div class="relative -mb-[clamp(8px,2.5vh,64px)] mt-auto aspect-[5/1] w-full max-w-[44rem] max-sm:order-3 sm:aspect-[7/1] lg:max-w-[56rem]" aria-hidden="true">

        <svg class="absolute inset-0 size-full overflow-visible" viewBox="0 0 1000 200" preserveAspectRatio="none" fill="none">
          <path d="M100 94.8 Q500 5.2 900 94.8" class="stroke-blue/40 dark:stroke-[#9a90ff]/45" stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>
        {heroPath.map((t, i) => (
          <span class:list={["absolute -translate-x-1/2 -translate-y-1/2", t.pos]}>
            <span class:list={["float grid place-items-center", `float-${i}`, t.main ? "size-14 rounded-xl bg-blue text-white shadow-[0_14px_36px_-6px_rgb(42_23_255/0.55)] sm:size-[72px] sm:rounded-xl" : "size-10 rounded-xl bg-surface text-blue shadow-[0_10px_28px_-10px_rgb(42_23_255/0.35),0_0_0_1px_rgb(42_23_255/0.06)] sm:size-14 sm:rounded-xl dark:bg-surface-2 dark:text-[#9a90ff] dark:shadow-[0_10px_28px_-10px_rgb(0_0_0/0.8),0_0_0_1px_rgb(255_255_255/0.08)]"]}>
              <svg class:list={[t.main ? "size-7 sm:size-9" : "size-5 sm:size-7"]} viewBox="0 0 24 24" fill={t.fill ? "currentColor" : "none"} stroke={t.fill ? "none" : "currentColor"} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{t.d.map((d) => <path d={d} />)}</svg>
            </span>
          </span>
        ))}
      </div>
    </section>

    <!-- How it works: the loop, shown inside an editor -->
    <section id="how" aria-labelledby="how-title" class="backdrop bg-dots-light gutter scroll-mt-24 border-y border-line bg-surface py-20 text-ink md:py-28">
      <div class="flex max-w-3xl flex-col gap-5">
        <h2 id="how-title" data-reveal class="text-title font-bold text-balance">One loop, from first commit to launch.</h2>
        <p class="text-[21px] text-muted" data-reveal>Build, verify, learn, launch. Every pass through the loop makes your app safer and you more confident.</p>
      </div>

      <div class="mt-12 overflow-hidden rounded-3xl bg-[#111] text-white shadow-2xl shadow-black/20 ring-1 ring-white/10" data-reveal>
        <!-- Title bar -->
        <div class="flex items-center gap-2 border-b border-white/10 px-5 py-3.5">
          <span class="size-3 rounded-full bg-[#ff5f57]" aria-hidden="true"></span>
          <span class="size-3 rounded-full bg-[#febc2e]" aria-hidden="true"></span>
          <span class="size-3 rounded-full bg-[#28c840]" aria-hidden="true"></span>
          <span class="flex-1 truncate text-center font-mono text-[13px] text-white/50">my-first-app<span class="hidden sm:inline"> — your editor + Launchwright</span></span>
          <span class="w-[52px]" aria-hidden="true"></span>
        </div>

        <div class="grid lg:grid-cols-[250px_minmax(0,1fr)]">
          <!-- Sidebar: the steps -->
          <aside class="border-b border-white/10 bg-white/[0.03] lg:border-b-0 lg:border-r">
            <p class="hidden px-5 pb-2 pt-5 font-mono text-[12px] uppercase tracking-[0.12em] text-white/55 lg:block">Walkthrough</p>
            <div role="tablist" aria-label="How it works" aria-orientation="vertical" data-tabs class="grid grid-cols-2 gap-1 p-2 lg:flex lg:flex-col lg:p-3 lg:pt-1">
              {loop.map((s, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${s.id}`}
                  aria-controls={`panel-${s.id}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                  class="flex flex-none cursor-pointer items-center gap-3 rounded-2xl px-3.5 py-2.5 text-left text-[17px] font-medium text-white/60 transition hover:bg-white/5 hover:text-white aria-selected:bg-white/10 aria-selected:text-white"
                >
                  <span class="grid size-7 flex-none place-items-center rounded-lg bg-white/10 font-mono text-[12px]">{String(i + 1).padStart(2, "0")}</span>{s.step}
                </button>
              ))}
            </div>
            <div class="hidden px-5 pb-5 pt-6 lg:block">
              <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-white/55">MCP servers</p>
              <p class="mt-3 flex items-center gap-2 text-[15px] text-white/75"><span class="size-2 rounded-full bg-lime" aria-hidden="true"></span>launchwright</p>
            </div>
          </aside>

          <!-- One panel per step: editor + terminal + explanation -->
          <div>
            {loop.map((s, i) => (
              <div role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} data-panel class="grid xl:grid-cols-[minmax(0,1fr)_340px]">
                <div class="flex min-w-0 flex-col">
                  <!-- Editor tab -->
                  <div class="flex border-b border-white/10 bg-white/[0.02]">
                    <span class="flex items-center gap-2 border-r border-white/10 border-t-2 border-t-lime bg-night px-4 py-2.5 font-mono text-[13px] text-white/85">
                      <span class="rounded bg-white/10 px-1 text-[10px] text-white/70">{icon[s.lang]}</span>{s.file}
                    </span>
                  </div>
                  <!-- Code -->
                  <pre class="m-0 overflow-x-auto py-5 font-mono text-[17px] leading-[1.8]"><code class="flex min-w-max flex-col bg-transparent p-0 text-white/85">{s.code.map((line, n) => (
                    <span class:list={["flex border-l-2", focus[s.id]?.includes(n + 1) ? "border-lime bg-lime/10" : "border-transparent"]}><span class="w-12 flex-none select-none pr-4 text-right text-white/40">{n + 1}</span><span class="whitespace-pre pr-6" set:html={highlight(line, s.lang) || " "} /></span>
                  ))}</code></pre>
                  <!-- Terminal panel -->
                  <div class="mt-auto border-t border-white/10">
                    <div class="flex gap-5 px-5 pt-3 font-mono text-[12px] uppercase tracking-[0.12em]">
                      <span class="border-b-2 border-lime pb-2 text-white/85">Terminal</span>
                      <span class="pb-2 text-white/50">Problems</span>
                      <span class="pb-2 text-white/50">Output</span>
                    </div>
                    <div class="min-h-[200px] px-5 pb-5 pt-3"><TermLines lines={s.term} /></div>
                  </div>
                </div>
                <!-- Explanation -->
                <div class="flex flex-col gap-4 border-t border-white/10 bg-white/[0.03] p-6 md:p-8 xl:border-l xl:border-t-0">
                  <p class="font-mono text-[13px] text-white/60">Step {i + 1} of 4 · {s.step}</p>
                  <h3 class="text-[1.75rem] font-bold leading-tight tracking-[-0.015em]">{s.title}</h3>
                  <p class="text-[17px] leading-relaxed text-white/70">{s.body}</p>
                  <div class="mt-auto flex flex-wrap gap-2 pt-2">
