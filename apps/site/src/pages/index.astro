        </ol>
      </div>
    </section>
    <!-- FAQ: without JS every answer shows; site.ts turns each question into a toggle. -->
    <section id="faq" aria-labelledby="faq-title" class="gutter scroll-mt-24 py-20 md:py-28">
      <div class="mx-auto flex max-w-[52rem] flex-col gap-10">
