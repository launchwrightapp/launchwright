{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "launchwright-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Builds the Astro site into dist/ before dev, deploy, and preview uploads.
  "build": { "command": "npm run build" },
  // Production is served only on the custom domains below.
  // Preview URLs (per PR) live on workers.dev.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "launchwright.app", "custom_domain": true },
    { "pattern": "www.launchwright.app", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Pilot emails (acknowledgement on signup, acceptance from the admin command).
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hello@launchwright.app"] }]
  // Secrets (not in this file): DATABASE_URL and ADMIN_TOKEN via `npx wrangler versions secret put <NAME>`
}
