---
// Searchable dropdown (combobox + listbox). Behavior: dropdown.ts.
// Picking an option fires `lw:dropdown-change` on document with { name, value }.
export interface Option { value: string; label: string; hint?: string }
interface Props {
  id: string;
  name: string; // what the value controls, e.g. "level"
  label: string; // shown before the value and used as the accessible name
  options: Option[];
  value: string;
  tone?: "light" | "dark";
  hideLabelBelow?: "sm" | "md" | "lg" | "xl";
  searchPlaceholder?: string;
  size?: "md" | "sm";
  align?: "left" | "right"; // which edge the menu lines up with
}
const { id, name, label, options, value, tone = "light", hideLabelBelow, searchPlaceholder = "Search", size = "md", align = "right" } = Astro.props;
const sizing = size === "sm" ? "min-h-9 gap-1.5 pl-3.5 pr-2.5 text-[14px]" : "min-h-11 gap-2 pl-4 pr-3.5 text-[15px]";
const current = options.find((o) => o.value === value) ?? options[0];
const trigger = tone === "dark"
  ? "border-white/15 bg-white/5 text-white hover:bg-white/10"
  : "border-line bg-surface text-ink shadow-xs hover:bg-surface-2";
const labelHide = { sm: "max-sm:hidden", md: "max-md:hidden", lg: "max-lg:hidden", xl: "max-xl:hidden" } as const;
---
<div class="relative" data-dropdown data-name={name}>
  <button
    type="button"
    data-dropdown-trigger
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={`${id}-pop`}
    aria-label={`${label}: ${current.label}`}
    class:list={["flex cursor-pointer items-center rounded-lg border font-semibold", sizing, trigger]}
  >
    <span class:list={["font-normal opacity-60", hideLabelBelow && labelHide[hideLabelBelow]]}>{label}</span>{" "}<span data-dropdown-value>{current.label}</span>
    <svg class="size-3.5 opacity-70 transition in-aria-expanded:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </button>

  <div
    id={`${id}-pop`}
    data-dropdown-pop
    hidden
    class:list={["absolute top-[calc(100%+10px)] z-40 flex w-[min(20rem,calc(100vw-2rem))] flex-col gap-2 rounded-2xl border border-line bg-surface p-2.5 text-ink shadow-2xl shadow-black/15", align === "left" ? "left-0" : "right-0"]}
  >
    <div class="relative">
      <svg class="pointer-events-none absolute left-4 top-1/2 size-4 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input
        type="text"
        role="combobox"
        data-dropdown-search
        aria-label={`Search ${label.toLowerCase()} options`}
        aria-controls={`${id}-list`}
        aria-expanded="true"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
        placeholder={searchPlaceholder}
        class="input min-h-11 rounded-lg py-2 pl-10 text-[16px]"
      />
    </div>
    <ul id={`${id}-list`} role="listbox" aria-label={label} class="flex max-h-72 flex-col gap-1 overflow-y-auto">
      {options.map((o) => (
        <li
          role="option"
          id={`${id}-opt-${o.value}`}
          data-value={o.value}
          aria-selected={o.value === current.value ? "true" : "false"}
          class="group flex cursor-pointer items-start gap-3 rounded-2xl px-3.5 py-3 data-[active]:bg-surface-2 dark:data-[active]:bg-surface-3"
        >
          <span class="min-w-0 flex-1">
            <span class="block font-semibold" data-dropdown-label>{o.label}</span>
            {o.hint && <span class="block text-[15px] text-muted">{o.hint}</span>}
          </span>
          <svg class="mt-1 size-4 flex-none text-ink opacity-0 group-aria-selected:opacity-100" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3 3 7-7" /></svg>
        </li>
      ))}
    </ul>
    <p data-dropdown-empty hidden class="px-3.5 py-3 text-[15px] text-muted">No matches</p>
  </div>
</div>
